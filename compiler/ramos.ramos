fn elf(s: bytes, c: bytes, o: bytes, d: bytes, f: bytes) -> bytes {
    let rx = g(c, 4)
    let data = ((rx + 4095) / 4096) * 4096
    let size = data + g(c, 14)
    if size > buffer_len(o) { limit(s, c) }
    put(o, 0, 1179403647)
    buffer_set(o, 4, 2)
    buffer_set(o, 5, 1)
    buffer_set(o, 6, 1)
    buffer_set(o, 16, 2)
    buffer_set(o, 18, 62)
    put(o, 20, 1)
    put(o, 24, 4194304 + runtime_end())
    put(o, 32, 64)
    buffer_set(o, 52, 64)
    buffer_set(o, 54, 56)
    buffer_set(o, 56, 3)
    put(o, 64, 1)
    put(o, 68, 5)
    put(o, 80, 4194304)
    put(o, 88, 4194304)
    put(o, 96, rx)
    put(o, 104, rx)
    put(o, 112, 4096)
    put(o, 120, 1)
    put(o, 124, 4)
    put(o, 128, data)
    put(o, 136, 4194304 + data)
    put(o, 144, 4194304 + data)
    put(o, 152, g(c, 14))
    put(o, 160, g(c, 14))
    put(o, 168, 4096)
    put(o, 176, 1685382481)
    put(o, 180, 6)
    put(o, 224, 16)
    return finish(s, c, o, d, f, data, size)
}

fn section(o: bytes, at: int64, name: bytes, size: int64, rva: int64, raw_size: int64, raw: int64, flags: int64) {
    var i = 0
    while i < buffer_len(name) {
        buffer_set(o, at + i, buffer_get(name, i))
        i = i + 1
    }
    put(o, at + 8, size)
    put(o, at + 12, rva)
    put(o, at + 16, raw_size)
    put(o, at + 20, raw)
    put(o, at + 36, flags)
}
fn finish(s: bytes, c: bytes, o: bytes, d: bytes, f: bytes, data: int64, size: int64) -> bytes {
    if size > buffer_len(o) { limit(s, c) }
    var i = 0
    while i < g(c, 5) {
        let at = get(f, i * 12)
        let kind = get(f, i * 12 + 4)
        let value = get(f, i * 12 + 8)
        var target = 0
        if kind == 1 { target = field(c, value, 24) }
        if kind == 2 { target = get(f, 600000 + value * 4) }
        if kind == 3 { target = data + value }
        put(o, at, target - at - 4)
        i = i + 1
    }
    i = 0
    while i < g(c, 14) {
        buffer_set(o, data + i, buffer_get(d, i))
        i = i + 1
    }
    let result = buffer(size)
    i = 0
    while i < size {
        buffer_set(result, i, buffer_get(o, i))
        i = i + 1
    }
    return result
}
fn pe(s: bytes, c: bytes, o: bytes, d: bytes, f: bytes) -> bytes {
    let rx = g(c, 4)
    let data = ((rx + 4095) / 4096) * 4096
    var data_size = ((g(c, 14) + 4095) / 4096) * 4096
    if data_size == 0 { data_size = 4096 }
