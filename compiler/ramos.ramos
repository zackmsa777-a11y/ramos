    put(o, 184, 4096)
    put(o, 188, 4096)
    put(o, 192, 6)
    put(o, 200, 6)
    put(o, 208, 2105344)
    put(o, 212, 4096)
    put(o, 220, 23068675)
    put(o, 224, 8388608)
    put(o, 232, 4096)
    put(o, 240, 1048576)
    put(o, 248, 4096)
    put(o, 260, 16)
    put(o, 272, 2097152)
    put(o, 276, 60)
    put(o, 304, 2101248)
    put(o, 308, 12)
    put(o, 360, 2097280)
    put(o, 364, 176)
    section(o, 392, ".text", rx - 4096, 4096, data - 4096, 4096, 1610612768)
    section(o, 432, ".rdata", 2097152 - data, data, data_size, data, 1073741888)
    section(o, 472, ".idata", 4096, 2097152, 4096, imports, -1073741760)
    section(o, 512, ".reloc", 12, 2101248, 4096, reloc, 1107296320)
    set(c, 4, imports)
    hex(s, c, o, windows_imports())
    put(o, reloc, 4096)
    put(o, reloc + 4, 12)
    return finish(s, c, o, d, f, data, size)
}
fn native_address(c: bytes, n: int64) -> int64 {
    if g(c, 16) == 1 { return windows_address(n) }
    if n == 0 { return math_address() }
    if n == 1 { return depth_address() }
    if n == 2 { return literal_address() }
    if n == 3 { return integer_address() }
    if n == 4 { return boolean_address() }
    return print_buffer_address()
}
fn native_builtin(c: bytes, n: int64) -> int64 {
    if g(c, 16) == 1 { return windows_builtin(n) }
    return builtin_address(n)
}
fn module(c: bytes, id: int64, p: int64) -> int64 { return get(c, 801000 + id * 32 + p) }
fn mset(c: bytes, id: int64, p: int64, v: int64) { put(c, 801000 + id * 32 + p, v) }
fn copy_bytes(out: bytes, at: int64, source: bytes, begin: int64, count: int64) {
    var i = 0
    while i < count { buffer_set(out, at + i, buffer_get(source, begin + i))
        i = i + 1 }
}
fn module_path(c: bytes, id: int64) -> bytes {
    let path = buffer(module(c, id, 12))
    copy_bytes(path, 0, c, module(c, id, 8), buffer_len(path))
    return path
}
fn source_context(c: bytes, path: bytes, size: int64) {
    set(c, 0, 0)
    set(c, 1, 0)
    set(c, 15, 0)
    set(c, 21, 1)
    mset(c, 0, 0, 0)
    mset(c, 0, 4, size)
    mset(c, 0, 8, 803100)
    mset(c, 0, 12, buffer_len(path))
    mset(c, 0, 16, 1)
    copy_bytes(c, 803100, path, 0, buffer_len(path))
}
fn lower_ascii(v: int64) -> int64 {
    if v >= 65 { if v <= 90 { return v + 32 } }
    return v
}
fn normalize_path(s: bytes, c: bytes, path: bytes) -> bytes {
    if buffer_len(path) == 0 { fail(s, c, "empty source path") }
    if buffer_len(path) >= 4096 { fail(s, c, "source path exceeds 4095 bytes") }
    let out = buffer(4096)
    let segments = buffer(4096)
    var used = 0
    var i = 0
    var depth = 0
    var rooted = false
    var floor = 0
    var base = 0
    if buffer_get(path, 0) == 47 {
        rooted = true
        buffer_set(out, 0, 47)
        used = 1
        i = 1
        if platform() == 1 { if buffer_len(path) > 1 { if buffer_get(path, 1) == 47 {
            buffer_set(out, 1, 47)
            used = 2
            i = 2
            floor = 2
        } } }
    }
    if platform() == 1 {
        if buffer_get(path, 0) == 92 {
            rooted = true
            buffer_set(out, 0, 47)
            used = 1
            i = 1
            if buffer_len(path) > 1 { if buffer_get(path, 1) == 92 {
                buffer_set(out, 1, 47)
                used = 2
                i = 2
                floor = 2
            } }
        }
        if buffer_len(path) >= 2 { if buffer_get(path, 1) == 58 {
            if buffer_len(path) < 3 { fail(s, c, "drive-relative source paths are not supported") }
            let separator = buffer_get(path, 2)
            if separator != 47 { if separator != 92 { fail(s, c, "drive-relative source paths are not supported") } }
            rooted = true
            buffer_set(out, 0, buffer_get(path, 0))
            buffer_set(out, 1, 58)
            buffer_set(out, 2, 47)
            used = 3
            i = 3
        } }
    }
    base = used
    while i < buffer_len(path) {
        let v = buffer_get(path, i)
        if v < 32 { fail(s, c, "control characters are not allowed in source paths") }
        if v == 47 { i = i + 1
            continue }
        if platform() == 1 { if v == 92 { i = i + 1
            continue } }
        let start = i
        while i < buffer_len(path) {
            let w = buffer_get(path, i)
            if w < 32 { fail(s, c, "control characters are not allowed in source paths") }
            if w == 47 { break }
            if platform() == 1 { if w == 92 { break } }
            i = i + 1
        }
        let n = i - start
        if matches(path, start, n, ".") { continue }
        if matches(path, start, n, "..") {
            if depth > floor {
                if get(segments, (depth - 1) * 8 + 4) == 0 {
                    used = get(segments, (depth - 1) * 8)
                    depth = depth - 1
                    continue
                }
            }
            if rooted { continue }
        }
        if depth >= 512 { fail(s, c, "source path exceeds 512 components") }
        put(segments, depth * 8, used)
        var parent = 0
        if matches(path, start, n, "..") { parent = 1 }
        put(segments, depth * 8 + 4, parent)
        depth = depth + 1
        if used > base { buffer_set(out, used, 47)
            used = used + 1 }
        copy_bytes(out, used, path, start, n)
        used = used + n
    }
    if used == 0 { buffer_set(out, 0, 46)
        used = 1 }
    let result = buffer(used)
    copy_bytes(result, 0, out, 0, used)
    return result
}
fn module_matches(c: bytes, id: int64, path: bytes) -> bool {
    if module(c, id, 12) != buffer_len(path) { return false }
    var i = 0
    while i < buffer_len(path) {
        var a = buffer_get(c, module(c, id, 8) + i)
        var b = buffer_get(path, i)
        if platform() == 1 { a = lower_ascii(a)
            b = lower_ascii(b) }
        if a != b { return false }
        i = i + 1
    }
    return true
}
fn module_add(s: bytes, diagnostic: bytes, c: bytes, path: bytes, parent: int64, position: int64) -> int64 {
    var id = 0
    while id < g(c, 21) {
        if module_matches(c, id, path) { return id }
        id = id + 1
    }
    if id >= 64 { fail(s, diagnostic, "weave limit: at most 64 source files") }
    let at = g(c, 22)
    if at + buffer_len(path) > 845000 { fail(s, diagnostic, "weave limit: source paths exceed 41900 bytes") }
    mset(c, id, 8, at)
    mset(c, id, 12, buffer_len(path))
    mset(c, id, 20, parent)
    mset(c, id, 24, position)
    copy_bytes(c, at, path, 0, buffer_len(path))
    set(c, 22, at + buffer_len(path))
    set(c, 21, id + 1)
    return id
}
fn reachable(c: bytes, start: int64, goal: int64) -> bool {
    let seen = buffer(64)
    let pending = buffer(64)
    buffer_set(pending, 0, start)
    buffer_set(seen, start, 1)
    var count = 1
    while count > 0 {
        count = count - 1
        let id = buffer_get(pending, count)
        if id == goal { return true }
        var child = 0
        while child < g(c, 21) {
            if buffer_get(c, 845000 + id * 64 + child) == 1 {
                if buffer_get(seen, child) == 0 {
                    buffer_set(seen, child, 1)
                    buffer_set(pending, count, child)
                    count = count + 1
                }
            }
            child = child + 1
        }
    }
    return false
}
fn weave_path(s: bytes, t: bytes, parent: bytes) -> bytes {
    if tk(t) != 9 { fail(s, t, "weave requires a quoted relative source path") }
    if length(t) - 2 >= 4096 { fail(s, t, "weave path exceeds 4095 bytes") }
    let path = buffer(length(t) - 2)
    var p = off(t) + 1
    let end = off(t) + length(t) - 1
    var used = 0
    while p < end {
        var v = buffer_get(s, p)
        p = p + 1
        if v == 92 {
            v = buffer_get(s, p)
            p = p + 1
            if v == 110 { v = 10 }
            if v == 116 { v = 9 }
            if v == 114 { v = 13 }
            if v == 48 { v = 0 }
        }
        if v < 32 { fail(s, t, "control characters are not allowed in weave paths") }
        if v == 92 { fail(s, t, "use '/' separators in weave paths") }
        buffer_set(path, used, v)
        used = used + 1
    }
    if used == 0 { fail(s, t, "weave path must not be empty") }
    if buffer_get(path, 0) == 47 { fail(s, t, "weave paths must be relative to the containing file") }
    if used > 1 { if buffer_get(path, 1) == 58 { fail(s, t, "weave paths must be relative to the containing file") } }
    var prefix = buffer_len(parent)
    while prefix > 0 {
        if buffer_get(parent, prefix - 1) == 47 { break }
        prefix = prefix - 1
    }
    let joined = buffer(prefix + used)
    copy_bytes(joined, 0, parent, 0, prefix)
    copy_bytes(joined, prefix, path, 0, used)
    return normalize_path(s, t, joined)
}
fn load_sources(c: bytes) -> bytes {
    let out = buffer(1048576)
    let temporary = buffer(1048576)
    set(c, 22, 803100)
    let root = normalize_path(buffer(0), c, arg(2))
    module_add(buffer(0), c, c, root, 0, 0)
    var id = 0
    while id < g(c, 21) {
        let path = module_path(c, id)
        let source = read_file(path)
        if io_error() != 0 {
            if id == 0 { source_context(temporary, path, 0)
                fail(source, temporary, "cannot read input (readable regular file required; source size limit is 1048576)") }
            set(c, 15, module(c, id, 24) + 1)
            fail(out, c, concat("cannot read weave source: ", path))
        }
        source_context(temporary, path, buffer_len(source))
        if _protect_input() != 0 { fail(source, temporary, "cannot protect weave source identity") }
        utf8(source, temporary)
        lex(source, temporary)
        set(c, 24, g(c, 24) + g(temporary, 1) - 1)
        if g(c, 24) >= 50000 { fail(source, temporary, "compiler token limit exceeded across weave sources") }
        var start = g(c, 23)
        if start > 0 { if buffer_get(out, start - 1) != 10 {
            if start >= 1048576 { fail(source, temporary, "weave source total exceeds 1048576 bytes") }
            buffer_set(out, start, 10)
            start = start + 1
        } }
        if start + buffer_len(source) > 1048576 { fail(source, temporary, "weave source total exceeds 1048576 bytes") }
        copy_bytes(out, start, source, 0, buffer_len(source))
        mset(c, id, 0, start)
        mset(c, id, 4, start + buffer_len(source))
        mset(c, id, 16, 1)
        set(c, 23, start + buffer_len(source))
        var braces = 0
        while tk(temporary) != 0 {
            let kind = tk(temporary)
            if kind == 51 {
                if braces != 0 { fail(source, temporary, "weave is only allowed at top level") }
                let position = off(temporary)
                next(temporary)
                let child_path = weave_path(source, temporary, path)
                let child = module_add(source, temporary, c, child_path, id, start + position)
                if reachable(c, child, id) { fail(source, temporary, "weave dependency cycle") }
                buffer_set(c, 845000 + id * 64 + child, 1)
                next(temporary)
                if tk(temporary) != 1 { if tk(temporary) != 0 { fail(source, temporary, "expected newline after weave path") } }
                continue
            }
            if kind == 7 { braces = braces + 1 }
            if kind == 8 { braces = braces - 1 }
            if id > 0 { if kind == 2 {
                let saved = g(temporary, 0)
                next(temporary)
                skip(temporary)
                if tk(temporary) == 3 { fail(source, temporary, "weave libraries cannot define main") }
                set(temporary, 0, saved)
            } }
            token(out, c, kind, start + off(temporary), length(temporary))
            next(temporary)
        }
        if braces > 0 { fail(source, temporary, "expected '}' to close source body") }
        id = id + 1
    }
    token(out, c, 0, g(c, 23), 0)
    set(c, 0, 0)
    set(c, 15, 0)
    let result = buffer(g(c, 23))
    copy_bytes(result, 0, out, 0, buffer_len(result))
    return result
}
fn usage() {
    stderr("error: usage: ramos build SOURCE.ramos -o PROGRAM [--force] [--target linux|windows]\n")
    exit(1)
}
fn main() {
    let argc = arg_count()
    if argc == 2 {
        let option = arg(1)
        if equal(option, "--version") { print("Ramos 0.11.0 — compiler written in Ramos; Linux and Windows x64")
            return }
        if equal(option, "--help") { print("Usage: ramos build SOURCE.ramos -o PROGRAM [--force] [--target linux|windows]")
            return }
    }
    if argc < 5 { usage() }
    if argc > 8 { usage() }
    if !equal(arg(1), "build") { usage() }
    if !equal(arg(3), "-o") { usage() }
    var flags = 1
    var target = platform()
    var selected = false
    var i = 5
    while i < argc {
        let option = arg(i)
        if equal(option, "--force") {
            if flags == 3 { usage() }
            flags = 3
        } else {
            if !equal(option, "--target") { usage() }
            if selected { usage() }
            selected = true
            i = i + 1
            if i >= argc { usage() }
            let name = arg(i)
            if equal(name, "windows") { target = 1 }
            else {
                if !equal(name, "linux") { usage() }
                target = 0
            }
        }
        i = i + 1
    }
    let c = buffer(1048576)
    set(c, 16, target)
    let s = load_sources(c)
    records(s, c)
    discover(s, c)
    let o = buffer(1048576)
    let d = buffer(1048576)
    let f = buffer(1048576)
    set(c, 4, 4096)
    if target == 0 {
        hex(s, c, o, runtime_text())
        hex(s, c, o, entry_text())
    } else {
        hex(s, c, o, windows_runtime())
        hex(s, c, o, windows_entry())
    }
    emit(s, c, o, 232)
    fix(s, c, o, f, 1, g(c, 3))
    if target == 0 { hex(s, c, o, "b83c00000031ff0f05") }
    else {
        emit(s, c, o, 233)
        relative(s, c, o, windows_return())
    }
    functions(s, c, o, d, f)
    var result = buffer(0)
    if target == 0 { result = elf(s, c, o, d, f) }
    else { result = pe(s, c, o, d, f) }
    if write_file(arg(4), result, flags) != 0 { fail(s, c, "cannot publish output: check existing file, source alias, directory and permissions") }
}

