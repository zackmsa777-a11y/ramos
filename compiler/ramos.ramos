            line_start = i + 1
            column = 1
        } else { column = column + 1 }
        i = i + 1
    }
    stderr(filename)
    stderr(":")
    stderr(decimal(line))
    stderr(":")
    stderr(decimal(column))
    stderr(": error: ")
    stderr(message)
    stderr("\n")
    var line_end = pos
