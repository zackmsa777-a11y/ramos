fn aggregate_assignment(s: bytes, c: bytes, o: bytes, d: bytes, f: bytes, found: int64) {
    if found < 0 { fail(s, c, "unknown variable") }
    var current_type = sym(c, found, 8)
    load(s, c, o, sym(c, found, 16))
    while true {
        var element_type = 2
