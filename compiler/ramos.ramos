            if t == 4 {
                next(c)
                expect(s, c, 5)
                let pt = expression(s, c, o, d, f)
                expect(s, c, 6)
                consume(s, c, o, 0)
                emit(s, c, o, 232)
                if pt == 5 { relative(s, c, o, native_builtin(c, 67)) }
                else { if pt == 0 { relative(s, c, o, native_address(c, 3)) }
                else {
                    if pt == 1 { relative(s, c, o, native_address(c, 4)) }
                    else {
                        if pt != 3 { if pt != 4 { fail(s, c, "print requires int64, float64, bool, bytes or string; a void call has no value") } }
                        relative(s, c, o, native_address(c, 5))
