    if left != 0 { if left != 5 { if kind != 55 {
        fail(s, c, "'+=' requires int64, float64 or string; '-=' requires int64 or float64")
    }
    if left != 4 {
        fail(s, c, "'+=' requires int64, float64 or string; '-=' requires int64 or float64")
    } } }
    set(c, 15, 0)
    typed(s, c, left)
    typed(s, c, right)
    var operator = 13
    if kind == 56 { operator = 14 }
    push_op(s, c, operator, 0)
    op_set(c, 0, 16, at)
    apply(s, c, o, f)
