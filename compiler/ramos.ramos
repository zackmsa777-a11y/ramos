    if matches(s, a, n, "buffer_get") { return 258 }
    if matches(s, a, n, "buffer_set") { return 259 }
    if matches(s, a, n, "arg_count") { return 260 }
    if matches(s, a, n, "arg") { return 261 }
    if matches(s, a, n, "read_file") { return 262 }
    if matches(s, a, n, "write_file") { return 263 }
    if matches(s, a, n, "io_error") { return 264 }
    if matches(s, a, n, "stderr") { return 265 }
    if matches(s, a, n, "exit") { return 266 }
    if matches(s, a, n, "platform") { return 267 }
    if matches(s, a, n, "read_line") { return 268 }
    if matches(s, a, n, "stdin_eof") { return 269 }
    if matches(s, a, n, "int_to_text") { return 270 }
    if matches(s, a, n, "text_to_int") { return 271 }
    if matches(s, a, n, "parse_error") { return 272 }
    if matches(s, a, n, "collect") { return 273 }
    if matches(s, a, n, "memory_used") { return 274 }
    if matches(s, a, n, "string") { return 275 }
    if matches(s, a, n, "to_bytes") { return 276 }
    if matches(s, a, n, "len") { return 277 }
    if matches(s, a, n, "slice") { return 278 }
    if matches(s, a, n, "array") { return 279 }
    if matches(s, a, n, "array_len") { return 280 }
    if matches(s, a, n, "array_get") { return 281 }
    if matches(s, a, n, "array_set") { return 282 }
    if matches(s, a, n, "array_resize") { return 283 }
    if matches(s, a, n, "array_empty") { return 289 }
