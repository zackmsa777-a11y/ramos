                        mark(c, f, a)
                        next(c)
                        expect(s, c, 7)
                        enter(s, c, 2, a, b, returned)
                        continue
                    }
                    mark(c, f, a)
                    if !separated { if tk(c) != 8 { bad(s, c) } }
                    continue
                }
                if kind == 2 {
                    mark(c, f, b)
                    if then_return == 1 { if returned == 1 { bset(c, top - 1, 16, 1) } }
                    separator(s, c)
                    continue
                }
                if kind == 3 {
                    jump(s, c, o, f, a)
                    mark(c, f, b)
                    separator(s, c)
                    continue
                }
            }
            if t == 23 {
                next(c)
                let condition_type = expression(s, c, o, d, f)
                if condition_type != 1 { type_error(s, c, 1, condition_type) }
                let no = label(s, c)
                let end = label(s, c)
                consume(s, c, o, 0)
                hex(s, c, o, "4885c00f84")
                fix(s, c, o, f, 2, no)
                expect(s, c, 7)
                enter(s, c, 1, no, end, 0)
                continue
            }
