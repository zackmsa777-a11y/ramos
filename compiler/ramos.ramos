fn records(s: bytes, c: bytes) {
    while true {
        skip(c)
        if tk(c) == 0 { break }
        if tk(c) == 46 {
            let start = g(c, 0)
            next(c)
            skip(c)
            if tk(c) != 11 { fail(s, c, "expected struct name") }
            let a = off(c)
            let n = length(c)
            if record_find(s, c, a, n) >= 0 { fail(s, c, "duplicate struct name") }
            if builtin(s, a, n) >= 0 { fail(s, c, "reserved intrinsic name") }
