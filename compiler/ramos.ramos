                expect(s, c, 54)
                skip(c)
                let end_type = expression(s, c, o, d, f)
                if end_type != 0 { type_error(s, c, 0, end_type) }
                let condition = label(s, c)
                let increment = label(s, c)
                let end = label(s, c)
