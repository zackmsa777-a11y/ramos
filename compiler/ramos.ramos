fn elf(s: bytes, c: bytes, o: bytes, d: bytes, f: bytes) -> bytes {
    let rx = g(c, 4)
    let data = ((rx + 4095) / 4096) * 4096
    let size = data + g(c, 14)
    if size > buffer_len(o) { limit(s, c) }
    put(o, 0, 1179403647)
    buffer_set(o, 4, 2)
    buffer_set(o, 5, 1)
    buffer_set(o, 6, 1)
    buffer_set(o, 16, 2)
    buffer_set(o, 18, 62)
    put(o, 20, 1)
    put(o, 24, 4194304 + runtime_end())
    put(o, 32, 64)
    buffer_set(o, 52, 64)
    buffer_set(o, 54, 56)
    buffer_set(o, 56, 3)
    put(o, 64, 1)
    put(o, 68, 5)
    put(o, 80, 4194304)
    put(o, 88, 4194304)
    put(o, 96, rx)
    put(o, 104, rx)
    put(o, 112, 4096)
    put(o, 120, 1)
    put(o, 124, 4)
    put(o, 128, data)
    put(o, 136, 4194304 + data)
    put(o, 144, 4194304 + data)
    put(o, 152, g(c, 14))
    put(o, 160, g(c, 14))
    put(o, 168, 4096)
    put(o, 176, 1685382481)
    put(o, 180, 6)
    put(o, 224, 16)
    return finish(s, c, o, d, f, data, size)
}

fn section(o: bytes, at: int64, name: bytes, size: int64, rva: int64, raw_size: int64, raw: int64, flags: int64) {
    var i = 0
    while i < buffer_len(name) {
        buffer_set(o, at + i, buffer_get(name, i))
        i = i + 1
    }
    put(o, at + 8, size)
    put(o, at + 12, rva)
    put(o, at + 16, raw_size)
    put(o, at + 20, raw)
    put(o, at + 36, flags)
}
fn finish(s: bytes, c: bytes, o: bytes, d: bytes, f: bytes, data: int64, size: int64) -> bytes {
    if size > buffer_len(o) { limit(s, c) }
    var i = 0
    while i < g(c, 5) {
        let at = get(f, i * 12)
        let kind = get(f, i * 12 + 4)
        let value = get(f, i * 12 + 8)
        var target = 0
        if kind == 1 { target = field(c, value, 24) }
        if kind == 2 { target = get(f, 600000 + value * 4) }
        if kind == 3 { target = data + value }
        put(o, at, target - at - 4)
        i = i + 1
    }
    i = 0
    while i < g(c, 14) {
        buffer_set(o, data + i, buffer_get(d, i))
        i = i + 1
    }
    let result = buffer(size)
    i = 0
    while i < size {
        buffer_set(result, i, buffer_get(o, i))
        i = i + 1
    }
    return result
}
fn pe(s: bytes, c: bytes, o: bytes, d: bytes, f: bytes) -> bytes {
    let rx = g(c, 4)
    let data = ((rx + 4095) / 4096) * 4096
    var data_size = ((g(c, 14) + 4095) / 4096) * 4096
    if data_size == 0 { data_size = 4096 }
    let imports = data + data_size
    let reloc = imports + 4096
    let size = reloc + 4096
    if size > buffer_len(o) { limit(s, c) }
    put(o, 0, 23117)
    put(o, 60, 128)
    put(o, 128, 17744)
    put(o, 132, 296548)
    put(o, 148, 2228464)
    put(o, 152, 523)
    put(o, 156, data - 4096)
    put(o, 160, data_size + 8192)
    put(o, 168, windows_end())
    put(o, 172, 4096)
    put(o, 176, 1073741824)
    put(o, 180, 1)
    put(o, 184, 4096)
    put(o, 188, 4096)
    put(o, 192, 6)
    put(o, 200, 6)
    put(o, 208, 2105344)
    put(o, 212, 4096)
    put(o, 220, 23068675)
    if g(c, 25) == 1 { put(o, 220, 23068674) }
    put(o, 224, 8388608)
    put(o, 232, 4096)
    put(o, 240, 1048576)
    put(o, 248, 4096)
    put(o, 260, 16)
    put(o, 272, 2097152)
    put(o, 276, 60)
    put(o, 304, 2101248)
    put(o, 308, 12)
    put(o, 360, 2097280)
    put(o, 364, windows_iat_size())
    section(o, 392, ".text", rx - 4096, 4096, data - 4096, 4096, 1610612768)
    section(o, 432, ".rdata", 2097152 - data, data, data_size, data, 1073741888)
    section(o, 472, ".idata", 4096, 2097152, 4096, imports, -1073741760)
    section(o, 512, ".reloc", 12, 2101248, 4096, reloc, 1107296320)
    set(c, 4, imports)
    hex(s, c, o, windows_imports())
    put(o, reloc, 4096)
    put(o, reloc + 4, 12)
    return finish(s, c, o, d, f, data, size)
}
fn native_address(c: bytes, n: int64) -> int64 {
    if g(c, 16) == 1 { return windows_address(n) }
    if n == 0 { return math_address() }
    if n == 1 { return depth_address() }
    if n == 2 { return literal_address() }
    if n == 3 { return integer_address() }
    if n == 4 { return boolean_address() }
    return print_buffer_address()
}
fn native_builtin(c: bytes, n: int64) -> int64 {
    if g(c, 16) == 1 { return windows_builtin(n) }
    return builtin_address(n)
}
fn module(c: bytes, id: int64, p: int64) -> int64 { return get(c, 801000 + id * 32 + p) }
fn mset(c: bytes, id: int64, p: int64, v: int64) { put(c, 801000 + id * 32 + p, v) }
fn copy_bytes(out: bytes, at: int64, source: bytes, begin: int64, count: int64) {
    var i = 0
    while i < count { buffer_set(out, at + i, buffer_get(source, begin + i))
        i = i + 1 }
}
fn module_path(c: bytes, id: int64) -> bytes {
    let path = buffer(module(c, id, 12))
    copy_bytes(path, 0, c, module(c, id, 8), buffer_len(path))
    return path
}
fn source_context(c: bytes, path: bytes, size: int64) {
    set(c, 0, 0)
    set(c, 1, 0)
    set(c, 15, 0)
    set(c, 21, 1)
    mset(c, 0, 0, 0)
    mset(c, 0, 4, size)
    mset(c, 0, 8, 803100)
    mset(c, 0, 12, buffer_len(path))
    mset(c, 0, 16, 1)
    copy_bytes(c, 803100, path, 0, buffer_len(path))
}
fn lower_ascii(v: int64) -> int64 {
    if v >= 65 { if v <= 90 { return v + 32 } }
    return v
}
fn normalize_path(s: bytes, c: bytes, path: bytes) -> bytes {
    if buffer_len(path) == 0 { fail(s, c, "empty source path") }
    if buffer_len(path) >= 4096 { fail(s, c, "source path exceeds 4095 bytes") }
    let out = buffer(4096)
    let segments = buffer(4096)
    var used = 0
    var i = 0
    var depth = 0
    var rooted = false
    var floor = 0
    var base = 0
    if buffer_get(path, 0) == 47 {
        rooted = true
        buffer_set(out, 0, 47)
        used = 1
        i = 1
        if platform() == 1 { if buffer_len(path) > 1 { if buffer_get(path, 1) == 47 {
            buffer_set(out, 1, 47)
            used = 2
            i = 2
            floor = 2
        } } }
    }
    if platform() == 1 {
        if buffer_get(path, 0) == 92 {
            rooted = true
            buffer_set(out, 0, 47)
            used = 1
            i = 1
            if buffer_len(path) > 1 { if buffer_get(path, 1) == 92 {
                buffer_set(out, 1, 47)
                used = 2
                i = 2
                floor = 2
            } }
        }
        if buffer_len(path) >= 2 { if buffer_get(path, 1) == 58 {
            if buffer_len(path) < 3 { fail(s, c, "drive-relative source paths are not supported") }
            let separator = buffer_get(path, 2)
            if separator != 47 { if separator != 92 { fail(s, c, "drive-relative source paths are not supported") } }
            rooted = true
            buffer_set(out, 0, buffer_get(path, 0))
            buffer_set(out, 1, 58)
            buffer_set(out, 2, 47)
            used = 3
            i = 3
        } }
    }
    base = used
    while i < buffer_len(path) {
        let v = buffer_get(path, i)
        if v < 32 { fail(s, c, "control characters are not allowed in source paths") }
        if v == 47 { i = i + 1
            continue }
        if platform() == 1 { if v == 92 { i = i + 1
            continue } }
        let start = i
        while i < buffer_len(path) {
            let w = buffer_get(path, i)
            if w < 32 { fail(s, c, "control characters are not allowed in source paths") }
            if w == 47 { break }
            if platform() == 1 { if w == 92 { break } }
            i = i + 1
        }
        let n = i - start
        if matches(path, start, n, ".") { continue }
        if matches(path, start, n, "..") {
            if depth > floor {
                if get(segments, (depth - 1) * 8 + 4) == 0 {
                    used = get(segments, (depth - 1) * 8)
                    depth = depth - 1
                    continue
                }
            }
            if rooted { continue }
        }
        if depth >= 512 { fail(s, c, "source path exceeds 512 components") }
        put(segments, depth * 8, used)
        var parent = 0
        if matches(path, start, n, "..") { parent = 1 }
        put(segments, depth * 8 + 4, parent)
        depth = depth + 1
        if used > base { buffer_set(out, used, 47)
            used = used + 1 }
        copy_bytes(out, used, path, start, n)
        used = used + n
    }
    if used == 0 { buffer_set(out, 0, 46)
        used = 1 }
    let result = buffer(used)
    copy_bytes(result, 0, out, 0, used)
    return result
}
fn module_matches(c: bytes, id: int64, path: bytes) -> bool {
    if module(c, id, 12) != buffer_len(path) { return false }
    var i = 0
    while i < buffer_len(path) {
        var a = buffer_get(c, module(c, id, 8) + i)
        var b = buffer_get(path, i)
        if platform() == 1 { a = lower_ascii(a)
            b = lower_ascii(b) }
        if a != b { return false }
        i = i + 1
    }
    return true
}
fn module_add(s: bytes, diagnostic: bytes, c: bytes, path: bytes, parent: int64, position: int64) -> int64 {
    var id = 0
    while id < g(c, 21) {
        if module_matches(c, id, path) { return id }
        id = id + 1
    }
    if id >= 64 { fail(s, diagnostic, "weave limit: at most 64 source files") }
    let at = g(c, 22)
    if at + buffer_len(path) > 845000 { fail(s, diagnostic, "weave limit: source paths exceed 41900 bytes") }
    mset(c, id, 8, at)
    mset(c, id, 12, buffer_len(path))
    mset(c, id, 20, parent)
    mset(c, id, 24, position)
    copy_bytes(c, at, path, 0, buffer_len(path))
    set(c, 22, at + buffer_len(path))
    set(c, 21, id + 1)
    return id
}
fn reachable(c: bytes, start: int64, goal: int64) -> bool {
    let seen = buffer(64)
    let pending = buffer(64)
    buffer_set(pending, 0, start)
    buffer_set(seen, start, 1)
    var count = 1
    while count > 0 {
        count = count - 1
        let id = buffer_get(pending, count)
        if id == goal { return true }
        var child = 0
        while child < g(c, 21) {
            if buffer_get(c, 845000 + id * 64 + child) == 1 {
                if buffer_get(seen, child) == 0 {
                    buffer_set(seen, child, 1)
                    buffer_set(pending, count, child)
                    count = count + 1
                }
            }
            child = child + 1
        }
    }
    return false
}
fn weave_path(s: bytes, t: bytes, parent: bytes) -> bytes {
    if tk(t) != 9 { fail(s, t, "weave requires a quoted relative source path") }
    if length(t) - 2 >= 4096 { fail(s, t, "weave path exceeds 4095 bytes") }
    let path = buffer(length(t) - 2)
    var p = off(t) + 1
    let end = off(t) + length(t) - 1
    var used = 0
    while p < end {
        var v = buffer_get(s, p)
        p = p + 1
        if v == 92 {
            v = buffer_get(s, p)
            p = p + 1
            if v == 110 { v = 10 }
            if v == 116 { v = 9 }
            if v == 114 { v = 13 }
            if v == 48 { v = 0 }
        }
        if v < 32 { fail(s, t, "control characters are not allowed in weave paths") }
        if v == 92 { fail(s, t, "use '/' separators in weave paths") }
        buffer_set(path, used, v)
        used = used + 1
    }
    if used == 0 { fail(s, t, "weave path must not be empty") }
    if buffer_get(path, 0) == 47 { fail(s, t, "weave paths must be relative to the containing file") }
    if used > 1 { if buffer_get(path, 1) == 58 { fail(s, t, "weave paths must be relative to the containing file") } }
    var prefix = buffer_len(parent)
    while prefix > 0 {
        if buffer_get(parent, prefix - 1) == 47 { break }
        prefix = prefix - 1
    }
    let joined = buffer(prefix + used)
    copy_bytes(joined, 0, parent, 0, prefix)
    copy_bytes(joined, prefix, path, 0, used)
    return normalize_path(s, t, joined)
}
fn load_sources(c: bytes) -> bytes {
    let out = buffer(1048576)
    let temporary = buffer(1048576)
    set(c, 22, 803100)
    let root = normalize_path(buffer(0), c, arg(2))
    module_add(buffer(0), c, c, root, 0, 0)
    var id = 0
    while id < g(c, 21) {
        let path = module_path(c, id)
        let source = read_file(path)
        if io_error() != 0 {
            if id == 0 { source_context(temporary, path, 0)
                fail(source, temporary, "cannot read input (readable regular file required; source size limit is 1048576)") }
            set(c, 15, module(c, id, 24) + 1)
            fail(out, c, concat("cannot read weave source: ", path))
        }
        source_context(temporary, path, buffer_len(source))
        if _protect_input() != 0 { fail(source, temporary, "cannot protect weave source identity") }
        utf8(source, temporary)
        lex(source, temporary)
        set(c, 24, g(c, 24) + g(temporary, 1) - 1)
        if g(c, 24) >= 50000 { fail(source, temporary, "compiler token limit exceeded across weave sources") }
        var start = g(c, 23)
        if start > 0 { if buffer_get(out, start - 1) != 10 {
            if start >= 1048576 { fail(source, temporary, "weave source total exceeds 1048576 bytes") }
            buffer_set(out, start, 10)
            start = start + 1
        } }
        if start + buffer_len(source) > 1048576 { fail(source, temporary, "weave source total exceeds 1048576 bytes") }
        copy_bytes(out, start, source, 0, buffer_len(source))
        mset(c, id, 0, start)
        mset(c, id, 4, start + buffer_len(source))
        mset(c, id, 16, 1)
        set(c, 23, start + buffer_len(source))
        var braces = 0
        while tk(temporary) != 0 {
            let kind = tk(temporary)
            if kind == 51 {
                if braces != 0 { fail(source, temporary, "weave is only allowed at top level") }
                let position = off(temporary)
                next(temporary)
                let child_path = weave_path(source, temporary, path)
                let child = module_add(source, temporary, c, child_path, id, start + position)
                if reachable(c, child, id) { fail(source, temporary, "weave dependency cycle") }
                buffer_set(c, 845000 + id * 64 + child, 1)
                next(temporary)
                if tk(temporary) != 1 { if tk(temporary) != 0 { fail(source, temporary, "expected newline after weave path") } }
                continue
            }
            if kind == 7 { braces = braces + 1 }
            if kind == 8 { braces = braces - 1 }
            if id > 0 { if kind == 2 {
                let saved = g(temporary, 0)
                next(temporary)
                skip(temporary)
                if tk(temporary) == 3 { fail(source, temporary, "weave libraries cannot define main") }
                set(temporary, 0, saved)
            } }
            token(out, c, kind, start + off(temporary), length(temporary))
            next(temporary)
        }
        if braces > 0 { fail(source, temporary, "expected '}' to close source body") }
        id = id + 1
    }
    token(out, c, 0, g(c, 23), 0)
    set(c, 0, 0)
    set(c, 15, 0)
    let result = buffer(g(c, 23))
    copy_bytes(result, 0, out, 0, buffer_len(result))
    return result
}
fn format_byte(s: bytes, c: bytes, state: bytes, out: bytes, value: int64) {
    let used = g(state, 0)
    if used >= 1048576 { fail(s, c, "formatted source exceeds 1048576 bytes") }
    buffer_set(out, used, value)
    set(state, 0, used + 1)
    if value == 10 {
        if g(state, 6) == 0 {
            set(state, 6, 1)
            if used > 0 { if buffer_get(out, used - 1) == 13 { set(state, 6, 2) } }
        }
        set(state, 1, 1)
    }
    else { set(state, 1, 0) }
}
fn format_span(s: bytes, c: bytes, state: bytes, out: bytes, start: int64, size: int64) {
    var i = 0
    while i < size { format_byte(s, c, state, out, buffer_get(s, start + i))
        i = i + 1 }
}
fn format_indent(s: bytes, c: bytes, state: bytes, out: bytes, kind: int64) {
    var depth = g(state, 2)
    if kind == 8 { if depth > 0 { depth = depth - 1 } }
    var continuation = g(state, 3)
    if kind == 6 { continuation = continuation - 1 }
    if kind == 49 { continuation = continuation - 1 }
    if continuation > 0 { depth = depth + 1 }
    var count = depth * 4
    while count > 0 { format_byte(s, c, state, out, 32)
        count = count - 1 }
}
fn format_end_token(t: int64) -> bool {
    if t == 11 { return true }
    if t == 12 { return true }
    if t == 58 { return true }
    if t == 9 { return true }
    if t == 50 { return true }
    if t == 21 { return true }
    if t == 22 { return true }
    if t == 6 { return true }
    return t == 49
}
fn format_space(previous: int64, kind: int64, unary: bool) -> bool {
    if previous == 0 { return false }
    if previous == 47 {
        if kind == 47 { return true }
        if kind == 54 { return true }
    }
    if unary {
        if kind == 18 { return true }
        if kind == 29 { return true }
        if previous == 14 {
            if kind == 33 { return true }
            if kind == 34 { return true }
        }
    }
    if kind == 6 { return false }
    if kind == 49 { return false }
    if kind == 35 { return false }
    if kind == 36 { return false }
    if kind == 47 { return false }
    if kind == 54 { return false }
    if previous == 47 { return false }
    if previous == 54 { return false }
    if previous == 5 { return false }
    if previous == 48 { return false }
    if unary { return false }
    if kind == 5 {
        if previous == 23 { return true }
        if previous == 25 { return true }
        if previous == 38 { return true }
        return false
    }
    if kind == 48 { return !format_end_token(previous) }
    if kind == 8 { return previous != 7 }
    return true
}
fn format_source(s: bytes, c: bytes) -> bytes {
    let state = buffer(32)
    let out = buffer(1048576)
    set(state, 1, 1)
    var i = 0
    while i < buffer_len(s) {
        let value = buffer_get(s, i)
        if value == 32 { i = i + 1
            continue }
        if value == 9 { i = i + 1
            continue }
        var comment = 0
        if value == 47 { if i + 1 < buffer_len(s) {
            let next_byte = buffer_get(s, i + 1)
            if next_byte == 47 { comment = 1 }
            if next_byte == 42 { comment = 2 }
        } }
        if comment != 0 {
            let start = i
            i = i + 2
            if comment == 1 {
                while i < buffer_len(s) {
                    if buffer_get(s, i) == 10 { break }
                    if buffer_get(s, i) == 13 { break }
                    i = i + 1
                }
            } else {
                while i + 1 < buffer_len(s) {
                    if buffer_get(s, i) == 42 { if buffer_get(s, i + 1) == 47 {
                        i = i + 2
                        break
                    } }
                    i = i + 1
                }
            }
            if g(state, 1) == 1 { format_indent(s, c, state, out, 0) }
            else { format_byte(s, c, state, out, 32) }
            format_span(s, c, state, out, start, i - start)
            set(state, 4, 100)
            set(state, 5, 0)
            continue
        }
        while off(c) < i { next(c) }
        let kind = tk(c)
        if kind == 1 {
            format_span(s, c, state, out, i, length(c))
            if g(state, 6) == 0 { set(state, 6, length(c)) }
            set(state, 4, 0)
            set(state, 5, 0)
        } else {
            let previous = g(state, 4)
            if g(state, 1) == 1 { format_indent(s, c, state, out, kind) }
            else {
                if format_space(previous, kind, g(state, 5) == 1) { format_byte(s, c, state, out, 32) }
            }
            format_span(s, c, state, out, i, length(c))
            if kind == 7 { set(state, 2, g(state, 2) + 1) }
            if kind == 8 { if g(state, 2) > 0 { set(state, 2, g(state, 2) - 1) } }
            if kind == 5 { set(state, 3, g(state, 3) + 1) }
            if kind == 48 { set(state, 3, g(state, 3) + 1) }
            if kind == 6 { if g(state, 3) > 0 { set(state, 3, g(state, 3) - 1) } }
            if kind == 49 { if g(state, 3) > 0 { set(state, 3, g(state, 3) - 1) } }
            var unary = false
            if kind == 28 { unary = true }
            if kind == 14 { if !format_end_token(previous) { unary = true } }
            set(state, 5, 0)
            if unary { set(state, 5, 1) }
            set(state, 4, kind)
        }
        i = i + length(c)
        next(c)
    }
    if g(state, 0) > 0 { if buffer_get(out, g(state, 0) - 1) != 10 {
        if g(state, 6) == 2 { format_byte(s, c, state, out, 13) }
        format_byte(s, c, state, out, 10)
    } }
    let result = buffer(g(state, 0))
    copy_bytes(result, 0, out, 0, buffer_len(result))
    return result
}
fn format_command() {
    let argc = arg_count()
    var check = false
    var output = false
    var flags = 0
    if argc != 3 {
        if argc == 4 {
            if !equal(arg(3), "--check") { usage() }
            check = true
        } else {
            if argc < 5 { usage() }
            if argc > 6 { usage() }
            if !equal(arg(3), "-o") { usage() }
            output = true
            if argc == 6 {
                if !equal(arg(5), "--force") { usage() }
                flags = 2
            }
        }
    }
    let source = read_file(arg(2))
    if io_error() != 0 { tool_error("cannot read formatting source") }
    if _protect_input() != 0 { tool_error("cannot protect formatting source identity") }
    let c = buffer(1048576)
    source_context(c, arg(2), buffer_len(source))
    utf8(source, c)
    lex(source, c)
    let result = format_source(source, c)
    if check {
        if !equal(source, result) { stderr("needs formatting: ")
            stderr(arg(2))
            stderr("\n")
            exit(1) }
        return
    }
    if output {
        if write_file(arg(4), result, flags) != 0 { tool_error("cannot publish formatted output; source files and aliases are protected") }
    } else { if stdout(result) != 0 { tool_error("cannot write formatted output") } }
}
fn run_put(state: bytes, out: bytes, value: int64) {
    let used = g(state, 0)
    if used >= 32767 { tool_error("run arguments exceed 32767 packed UTF-8 bytes") }
    if value == 0 { tool_error("NUL is not allowed in run arguments") }
    buffer_set(out, used, value)
    set(state, 0, used + 1)
}
fn run_quote(state: bytes, out: bytes, text: bytes) {
    run_put(state, out, 34)
    var slashes = 0
    var i = 0
    while i < buffer_len(text) {
        let value = buffer_get(text, i)
        if value == 92 { slashes = slashes + 1 }
        else {
            var count = slashes
            if value == 34 { count = slashes * 2 + 1 }
            while count > 0 { run_put(state, out, 92)
                count = count - 1 }
            run_put(state, out, value)
            slashes = 0
        }
        i = i + 1
    }
    var count = slashes * 2
    while count > 0 { run_put(state, out, 92)
        count = count - 1 }
    run_put(state, out, 34)
}
fn run_command() {
    let argc = arg_count()
    var first = 3
    if argc > 3 {
        if !equal(arg(3), "--") { usage() }
        first = 4
    }
    if argc - first > 256 { tool_error("run accepts at most 256 program arguments") }
    let state = buffer(4)
    let packet = buffer(32767)
    if platform() == 1 { run_quote(state, packet, "ramos-run") }
    var i = first
    while i < argc {
        let text = arg(i)
        if platform() == 1 { run_put(state, packet, 32)
            run_quote(state, packet, text) }
        else {
            var j = 0
            while j < buffer_len(text) { run_put(state, packet, buffer_get(text, j))
                j = j + 1 }
            if g(state, 0) >= 32767 { tool_error("run arguments exceed 32767 packed UTF-8 bytes") }
            buffer_set(packet, g(state, 0), 0)
            set(state, 0, g(state, 0) + 1)
        }
        i = i + 1
    }
    let arguments = buffer(g(state, 0))
    copy_bytes(arguments, 0, packet, 0, buffer_len(arguments))
    let c = buffer(1048576)
    set(c, 16, platform())
    let binary = compile(c)
    let code = _run_file(binary, arguments)
    let status = io_error()
    if status != 0 { stderr("error: cannot publish, execute or clean temporary program (I/O status ")
        stderr(decimal(status))
        stderr(")\n")
        exit(1) }
    if code > 255 { exit(1) }
    exit(code)
}
fn compile(c: bytes) -> bytes {
    let target = g(c, 16)
    let s = load_sources(c)
    records(s, c)
    discover(s, c)
    let o = buffer(1048576)
    let d = buffer(1048576)
    let f = buffer(1048576)
    set(c, 4, 4096)
    if target == 0 {
        hex(s, c, o, runtime_text())
        hex(s, c, o, entry_text())
    } else {
        hex(s, c, o, windows_runtime())
        hex(s, c, o, windows_entry())
    }
    emit(s, c, o, 232)
    fix(s, c, o, f, 1, g(c, 3))
    if target == 0 { emit(s, c, o, 232)
        relative(s, c, o, native_builtin(c, 42))
        hex(s, c, o, "b83c00000031ff0f05") }
    else {
        emit(s, c, o, 233)
        relative(s, c, o, windows_return())
    }
    functions(s, c, o, d, f)
    var result = buffer(0)
    if target == 0 { result = elf(s, c, o, d, f) }
    else { result = pe(s, c, o, d, f) }
    return result
}
fn tool_error(message: bytes) {
    stderr("error: ")
    stderr(message)
    stderr("\n")
    exit(1)
}
fn usage() {
    stderr("error: usage: ramos build SOURCE.ramos -o PROGRAM [--force] [--target linux|windows] [--gui]\n       ramos run SOURCE.ramos [-- ARG...]\n       ramos fmt SOURCE.ramos [--check | -o FILE [--force]]\n")
    exit(1)
}
fn main() {
    let argc = arg_count()
    if argc == 2 {
        let option = arg(1)
        if equal(option, "--version") { print("Ramos 0.18.0 — compiler written in Ramos; Linux and Windows x64")
            return }
        if equal(option, "--help") { print("Usage: ramos build SOURCE.ramos -o PROGRAM [--force] [--target linux|windows] [--gui]\n       ramos run SOURCE.ramos [-- ARG...]\n       ramos fmt SOURCE.ramos [--check | -o FILE [--force]]")
            return }
    }
    if argc >= 3 {
        if equal(arg(1), "fmt") { format_command()
            return }
        if equal(arg(1), "run") { run_command()
            return }
    }
    if argc < 5 { usage() }
    if argc > 9 { usage() }
    if !equal(arg(1), "build") { usage() }
    if !equal(arg(3), "-o") { usage() }
    var flags = 1
    var target = platform()
    var gui = false
    var selected = false
    var i = 5
    while i < argc {
        let option = arg(i)
        if equal(option, "--force") {
            if flags == 3 { usage() }
            flags = 3
        } else {
            if equal(option, "--gui") {
                if gui { usage() }
                gui = true
            } else {
            if !equal(option, "--target") { usage() }
            if selected { usage() }
            selected = true
            i = i + 1
            if i >= argc { usage() }
            let name = arg(i)
            if equal(name, "windows") { target = 1 }
            else {
                if !equal(name, "linux") { usage() }
                target = 0
            }
        }
        }
        i = i + 1
    }
    if gui { if target != 1 { stderr("error: --gui requires --target windows\n")
        exit(1) } }
    let c = buffer(1048576)
    if gui { set(c, 25, 1) }
    set(c, 16, target)
    let result = compile(c)
    if write_file(arg(4), result, flags) != 0 { tool_error("cannot publish output: check existing file, source alias, directory and permissions") }
}

fn runtime_text() -> bytes { return "" }
fn entry_text() -> bytes { return "fc4531e44531ed4531f64889e24881ec900000004989e74889e731c0b912000000f348ab4989174883ec2048c704240100000048c74424080000000048c74424100000000048c744241800000000bf0d0000004889e631d241ba08000000b80d0000000f054883c42068801f00000fae14244883c408" }
fn runtime_end() -> int64 { return 13653 }
fn math_address() -> int64 { return 4226 }
fn depth_address() -> int64 { return 4267 }
fn literal_address() -> int64 { return 5116 }
fn integer_address() -> int64 { return 4152 }
fn boolean_address() -> int64 { return 4182 }
fn print_buffer_address() -> int64 { return 5169 }
fn builtin_address(n: int64) -> int64 {
    if n == 0 { return 4480 }
    if n == 1 { return 5133 }
    if n == 2 { return 5137 }
