    if matches(s, a, n, "slice") { return 278 }
    if matches(s, a, n, "array") { return 279 }
    if matches(s, a, n, "array_len") { return 280 }
    if matches(s, a, n, "array_get") { return 281 }
    if matches(s, a, n, "array_set") { return 282 }
    if matches(s, a, n, "array_resize") { return 283 }
    if matches(s, a, n, "array_empty") { return 289 }
    if matches(s, a, n, "_protect_input") { return 290 }
