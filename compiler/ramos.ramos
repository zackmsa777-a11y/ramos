        n = n / 256
        i = i + 1
    }
}
fn g(c: bytes, p: int64) -> int64 { return get(c, p * 4) }
fn set(c: bytes, p: int64, v: int64) { put(c, p * 4, v) }
fn equal(a: bytes, b: bytes) -> bool {
    if buffer_len(a) != buffer_len(b) { return false }
    var i = 0
    while i < buffer_len(a) {
