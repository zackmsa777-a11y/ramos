            set(c, 13, g(c, 13) - 1)
            next(c)
            continue
        }
        if t == 36 {
            while g(c, 11) > 0 {
                let top = op(c, g(c, 11) - 1, 0)
                if top == 5 { break }
                if top == 6 { break }
                if top == 48 { fail(s, c, "expected closing bracket for array index") }
                apply(s, c, o, f)
            }
            if g(c, 11) == 0 { break }
            let top = g(c, 11) - 1
            if op(c, top, 0) != 6 { bad(s, c) }
            argument(s, c, top)
            next(c)
            skip(c)
            wanted = true
