}
fn next_back(c: bytes) { set(c, 0, g(c, 0) - 1) }
fn block(c: bytes, i: int64, p: int64) -> int64 { return get(c, 850000 + i * 40 + p) }
fn bset(c: bytes, i: int64, p: int64, v: int64) { put(c, 850000 + i * 40 + p, v) }
fn enter(s: bytes, c: bytes, kind: int64, a: int64, b: int64, returned: int64) {
    let i = g(c, 10)
    if i >= 128 { limit(s, c) }
    bset(c, i, 0, kind)
    bset(c, i, 4, g(c, 7))
    bset(c, i, 8, a)
    bset(c, i, 12, b)
    bset(c, i, 16, 0)
    bset(c, i, 20, returned)
    set(c, 10, i + 1)
}
fn clear_scope(s: bytes, c: bytes, o: bytes, first: int64) {
    var i = first
    while i < g(c, 7) {
        hex(s, c, o, "48c785")
        number(s, c, o, -8 * (sym(c, i, 16) + 1), 4)
        number(s, c, o, 0, 4)
        i = i + 1
    }
}
fn epilogue(s: bytes, c: bytes, o: bytes, value: bool) {
    if value { consume(s, c, o, 0) }
    else { hex(s, c, o, "31c0") }
    hex(s, c, o, "c949ffccc3")
}
fn separator(s: bytes, c: bytes) {
    if tk(c) != 1 { if tk(c) != 8 { fail(s, c, "expected newline or closing brace") } }
    skip(c)
}
fn aggregate_assignment(s: bytes, c: bytes, o: bytes, d: bytes, f: bytes, found: int64) {
    if found < 0 { fail(s, c, "unknown variable") }
    var current_type = sym(c, found, 8)
    load(s, c, o, sym(c, found, 16))
    while true {
        var element_type = 2
        var index = 0
        var indexed = false
        if tk(c) == 47 {
            next(c)
            index = record_field(s, c, current_type)
            element_type = record(c, current_type - 1000, 40 + index * 20)
            next(c)
        } else {
            if tk(c) != 48 { fail(s, c, "expected field or array index") }
            if current_type < 100000 { fail(s, c, "indexing requires a typed array") }
            indexed = true
            element_type = current_type - 100000
            next(c)
            skip(c)
            let index_type = expression(s, c, o, d, f)
            if index_type != 0 { type_error(s, c, 0, index_type) }
            expect(s, c, 49)
            consume(s, c, o, 1)
            consume(s, c, o, 0)
            value_push(s, c, o)
            emit(s, c, o, 81)
            set(c, 19, 0)
        }
        if tk(c) == 18 {
            next(c)
            let value_type = expression(s, c, o, d, f)
            if value_type != element_type { type_error(s, c, element_type, value_type) }
            consume(s, c, o, 2)
            if indexed { consume(s, c, o, 1) }
            consume(s, c, o, 0)
            if !indexed { hex(s, c, o, "48b9")
                number(s, c, o, index, 8) }
            emit(s, c, o, 232)
            relative(s, c, o, native_builtin(c, 32))
            return
        }
        if indexed { consume(s, c, o, 1) }
        consume(s, c, o, 0)
        if !indexed { hex(s, c, o, "48b9")
            number(s, c, o, index, 8) }
        emit(s, c, o, 232)
        relative(s, c, o, native_builtin(c, 31))
        value_push(s, c, o)
