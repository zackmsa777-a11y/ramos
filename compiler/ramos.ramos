            }
            if t == 25 {
                let start = label(s, c)
                let end = label(s, c)
                mark(c, f, start)
                next(c)
                let condition_type = expression(s, c, o, d, f)
                if condition_type != 1 { type_error(s, c, 1, condition_type) }
                consume(s, c, o, 0)
                hex(s, c, o, "4885c00f84")
                fix(s, c, o, f, 2, end)
                expect(s, c, 7)
                enter(s, c, 3, start, end, 0)
