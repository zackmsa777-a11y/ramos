                            hex(s, c, o, "48b8")
                            number(s, c, o, 0, 8)
                            value_push(s, c, o)
                            typed(s, c, 1)
                            next(c)
                        } else {
                            if callable(t) {
                                let a = off(c)
                                let n = length(c)
                                let sy = symbol(s, c, a, n)
                                let id = find(s, c, a, n)
                                next(c)
                                if tk(c) == 5 {
                                    if sy >= 0 { fail(s, c, "a variable cannot be called as a function") }
