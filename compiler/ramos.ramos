                    skip(c)
                    if tk(c) == 24 {
                        jump(s, c, o, f, b)
                        mark(c, f, a)
                        next(c)
                        skip(c)
                        let all_return = then_return * returned
                        if tk(c) == 23 {
                            next(c)
                            let condition_type = expression(s, c, o, d, f)
                            if condition_type != 1 { type_error(s, c, 1, condition_type) }
