    while i < g(c, 14) {
        buffer_set(o, data + i, buffer_get(d, i))
        i = i + 1
    }
    let result = buffer(size)
    i = 0
    while i < size {
        buffer_set(result, i, buffer_get(o, i))
        i = i + 1
    }
    return result
}
fn pe(s: bytes, c: bytes, o: bytes, d: bytes, f: bytes) -> bytes {
    let rx = g(c, 4)
    let data = ((rx + 4095) / 4096) * 4096
    var data_size = ((g(c, 14) + 4095) / 4096) * 4096
    if data_size == 0 { data_size = 4096 }
    let imports = data + data_size
    let reloc = imports + 4096
    let size = reloc + 4096
    if size > buffer_len(o) { limit(s, c) }
    put(o, 0, 23117)
    put(o, 60, 128)
    put(o, 128, 17744)
    put(o, 132, 296548)
    put(o, 148, 2228464)
    put(o, 152, 523)
    put(o, 156, data - 4096)
    put(o, 160, data_size + 8192)
    put(o, 168, windows_end())
    put(o, 172, 4096)
    put(o, 176, 1073741824)
    put(o, 180, 1)
    put(o, 184, 4096)
    put(o, 188, 4096)
    put(o, 192, 6)
    put(o, 200, 6)
    put(o, 208, 2105344)
    put(o, 212, 4096)
    put(o, 220, 23068675)
    put(o, 224, 8388608)
    put(o, 232, 4096)
    put(o, 240, 1048576)
    put(o, 248, 4096)
    put(o, 260, 16)
    put(o, 272, 2097152)
    put(o, 276, 60)
    put(o, 304, 2101248)
    put(o, 308, 12)
    put(o, 360, 2097280)
    put(o, 364, 176)
    section(o, 392, ".text", rx - 4096, 4096, data - 4096, 4096, 1610612768)
    section(o, 432, ".rdata", 2097152 - data, data, data_size, data, 1073741888)
    section(o, 472, ".idata", 4096, 2097152, 4096, imports, -1073741760)
    section(o, 512, ".reloc", 12, 2101248, 4096, reloc, 1107296320)
    set(c, 4, imports)
    hex(s, c, o, windows_imports())
    put(o, reloc, 4096)
    put(o, reloc + 4, 12)
    return finish(s, c, o, d, f, data, size)
}
fn native_address(c: bytes, n: int64) -> int64 {
    if g(c, 16) == 1 { return windows_address(n) }
    if n == 0 { return math_address() }
    if n == 1 { return depth_address() }
    if n == 2 { return literal_address() }
    if n == 3 { return integer_address() }
    if n == 4 { return boolean_address() }
    return print_buffer_address()
}
fn native_builtin(c: bytes, n: int64) -> int64 {
    if g(c, 16) == 1 { return windows_builtin(n) }
    return builtin_address(n)
}
fn usage() {
    stderr("error: usage: ramos build SOURCE.ramos -o PROGRAM [--force] [--target linux|windows]\n")
    exit(1)
}
fn main() {
    let argc = arg_count()
    if argc == 2 {
        let option = arg(1)
        if equal(option, "--version") { print("Ramos 0.7.1 — compiler written in Ramos; Linux and Windows x64")
            return }
        if equal(option, "--help") { print("Usage: ramos build SOURCE.ramos -o PROGRAM [--force] [--target linux|windows]")
            return }
    }
    if argc < 5 { usage() }
    if argc > 8 { usage() }
    if !equal(arg(1), "build") { usage() }
    if !equal(arg(3), "-o") { usage() }
    var flags = 1
    var target = platform()
    var selected = false
    var i = 5
    while i < argc {
        let option = arg(i)
        if equal(option, "--force") {
            if flags == 3 { usage() }
            flags = 3
        } else {
            if !equal(option, "--target") { usage() }
            if selected { usage() }
            selected = true
            i = i + 1
            if i >= argc { usage() }
            let name = arg(i)
            if equal(name, "windows") { target = 1 }
            else {
                if !equal(name, "linux") { usage() }
                target = 0
            }
        }
        i = i + 1
    }
    let s = read_file(arg(2))
    let c = buffer(1048576)
    set(c, 16, target)
    if io_error() != 0 { fail(s, c, "cannot read input (readable regular file required; source size limit is 1048576)") }
    utf8(s, c)
    lex(s, c)
    discover(s, c)
    let o = buffer(1048576)
    let d = buffer(1048576)
    let f = buffer(1048576)
    set(c, 4, 4096)
    if target == 0 {
        hex(s, c, o, runtime_text())
        hex(s, c, o, entry_text())
    } else {
        hex(s, c, o, windows_runtime())
        hex(s, c, o, windows_entry())
    }
    emit(s, c, o, 232)
    fix(s, c, o, f, 1, g(c, 3))
    if target == 0 { hex(s, c, o, "b83c00000031ff0f05") }
    else {
        emit(s, c, o, 233)
        relative(s, c, o, windows_return())
    }
    functions(s, c, o, d, f)
    var result = buffer(0)
    if target == 0 { result = elf(s, c, o, d, f) }
    else { result = pe(s, c, o, d, f) }
    if write_file(arg(4), result, flags) != 0 { fail(s, c, "cannot publish output: check existing file, source alias, directory and permissions") }
}

