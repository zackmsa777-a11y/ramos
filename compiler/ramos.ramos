    var column = 1
    var i = 0
    while i < pos {
        if buffer_get(s, i) == 10 {
            line = line + 1
            column = 1
        } else { column = column + 1 }
        i = i + 1
    }
    stderr(arg(2))
    stderr(":")
    stderr(decimal(line))
    stderr(":")
    stderr(decimal(column))
