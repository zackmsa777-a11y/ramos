                store(s, c, o, slot)
                bset(c, top + 1, 24, slot)
                bset(c, top + 1, 28, bound)
                bset(c, top + 1, 32, condition)
                mark(c, f, condition)
                hex(s, c, o, "488b85")
                number(s, c, o, -8 * (slot + 1), 4)
                hex(s, c, o, "483b85")
                number(s, c, o, -8 * (bound + 1), 4)
                hex(s, c, o, "0f8d")
                fix(s, c, o, f, 2, end)
