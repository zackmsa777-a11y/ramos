    var negative = false
    if i < end {
        i = i + 1
        if buffer_get(s, i) == 43 { i = i + 1 }
        else { if buffer_get(s, i) == 45 { negative = true
            i = i + 1 } }
        while i < end {
            exponent = exponent * 10 + buffer_get(s, i) - 48
            if exponent > 400 { fail(s, c, "float literal exponent must be within -400..400") }
            i = i + 1
        }
    }
    if negative { exponent = -exponent }
    exponent = exponent - fraction
    if exponent >= 0 {
        i = 0
        while i < exponent { big_mul(n, 10, 0)
            i = i + 1 }
    } else {
        i = 0
        while i < -exponent { big_mul(d, 10, 0)
            i = i + 1 }
    }
    if big_bits(n) == 0 { return 0 }
    var power = big_bits(n) - big_bits(d)
    let compare_n = big_copy(n)
    let compare_d = big_copy(d)
    if power >= 0 { big_shift(compare_d, power) }
    else { big_shift(compare_n, -power) }
    if big_compare(compare_n, compare_d) < 0 { power = power - 1 }
    if power > 1023 { fail(s, c, "float literal exceeds finite float64 range") }
    if power < -1075 { return 0 }
    var shift = 52 - power
    if power < -1022 { shift = 1074 }
    if shift >= 0 { big_shift(n, shift) }
    else { big_shift(d, -shift) }
    let divisor = big_copy(d)
    big_shift(divisor, 53)
    var quotient = 0
    i = 53
    while i >= 0 {
