        p = p + 1
        if v == 92 {
            v = buffer_get(s, p)
            p = p + 1
            if v == 110 { v = 10 }
            if v == 116 { v = 9 }
            if v == 114 { v = 13 }
            if v == 48 { v = 0 }
        }
        let at = g(c, 14)
        if at >= buffer_len(d) { limit(s, c) }
        buffer_set(d, at, v)
        set(c, 14, at + 1)
    }
    hex(s, c, o, "488d35")
    fix(s, c, o, f, 3, start)
    hex(s, c, o, "48b8")
    number(s, c, o, g(c, 14) - start, 8)
    emit(s, c, o, 232)
    relative(s, c, o, literal_address())
    emit(s, c, o, 80)
    typed(s, c, 3)
    next(c)
}
fn call_emit(s: bytes, c: bytes, o: bytes, f: bytes, fnid: int64) {
    let n = arity(c, fnid)
    if fnid >= 256 {
        if n == 3 { emit(s, c, o, 90) }
        if n >= 2 { emit(s, c, o, 89) }
        if n >= 1 { emit(s, c, o, 88) }
        emit(s, c, o, 232)
        relative(s, c, o, builtin_address(fnid - 256))
    } else {
        emit(s, c, o, 232)
        fix(s, c, o, f, 1, fnid)
        if n > 0 {
            hex(s, c, o, "4881c4")
            number(s, c, o, n * 8, 4)
        }
    }
    emit(s, c, o, 80)
    typed(s, c, result_type(c, fnid))
}
fn argument(s: bytes, c: bytes, n: int64) {
    let f = op(c, n, 4)
    let i = op(c, n, 8)
    if i >= arity(c, f) { bad(s, c) }
    if g(c, 12) != op(c, n, 12) + 1 { bad(s, c) }
    let t = pop_type(s, c)
    if t != arg_type(c, f, i) { bad(s, c) }
    op_set(c, n, 8, i + 1)
}
fn expression(s: bytes, c: bytes, o: bytes, d: bytes, f: bytes) -> int64 {
    set(c, 11, 0)
    set(c, 12, 0)
    set(c, 13, 0)
    var wanted = true
    while true {
        let t = tk(c)
        if wanted {
            if t == 13 {
                push_op(s, c, 113, 0)
                next(c)
                skip(c)
                continue
            }
            if t == 14 {
                push_op(s, c, 114, 0)
                next(c)
                skip(c)
                continue
            }
            if t == 28 {
                push_op(s, c, 128, 0)
                next(c)
                skip(c)
                continue
            }
            if t == 5 {
                push_op(s, c, 5, 0)
                next(c)
                skip(c)
                continue
            }
            if t == 12 { literal(s, c, o) }
            else {
                if t == 9 { string(s, c, o, d, f) }
                else {
                    if t == 21 {
                        hex(s, c, o, "48b8")
                        number(s, c, o, 1, 8)
                        emit(s, c, o, 80)
                        typed(s, c, 1)
                        next(c)
                    } else {
                        if t == 22 {
                            hex(s, c, o, "48b8")
                            number(s, c, o, 0, 8)
                            emit(s, c, o, 80)
                            typed(s, c, 1)
                            next(c)
                        } else {
                            if t == 11 {
                                let a = off(c)
                                let n = length(c)
                                let sy = symbol(s, c, a, n)
                                let id = find(s, c, a, n)
                                next(c)
                                if tk(c) == 5 {
                                    if sy >= 0 { bad(s, c) }
                                    if id < 0 { next_back(c)
                                        bad(s, c) }
                                    push_op(s, c, 6, id)
                                    next(c)
                                    skip(c)
                                    if tk(c) == 6 {
                                        if arity(c, id) != 0 { bad(s, c) }
                                        set(c, 11, g(c, 11) - 1)
                                        set(c, 13, g(c, 13) - 1)
                                        call_emit(s, c, o, f, id)
                                        next(c)
                                    } else { continue }
                                } else {
                                    if sy < 0 { next_back(c)
                                        bad(s, c) }
                                    load(s, c, o, sym(c, sy, 16))
                                    typed(s, c, sym(c, sy, 8))
                                }
                            } else { bad(s, c) }
                        }
                    }
                }
            }
            wanted = false
            continue
        }
        while g(c, 11) > 0 {
            if op(c, g(c, 11) - 1, 0) < 100 { break }
            apply(s, c, o)
        }
        if prec(t) > 0 {
            while g(c, 11) > 0 {
                let top = op(c, g(c, 11) - 1, 0)
                if prec(top) < prec(t) { break }
                apply(s, c, o)
            }
            push_op(s, c, t, 0)
            next(c)
            skip(c)
            wanted = true
            continue
        }
        if t == 6 {
            while g(c, 11) > 0 {
                let top = op(c, g(c, 11) - 1, 0)
                if top == 5 { break }
                if top == 6 { break }
                apply(s, c, o)
            }
            if g(c, 11) == 0 { break }
            let top = g(c, 11) - 1
            if op(c, top, 0) == 6 {
                argument(s, c, top)
                let id = op(c, top, 4)
                if op(c, top, 8) != arity(c, id) { bad(s, c) }
                set(c, 11, top)
                call_emit(s, c, o, f, id)
            } else {
                if g(c, 12) != op(c, top, 12) + 1 { bad(s, c) }
                set(c, 11, top)
            }
            set(c, 13, g(c, 13) - 1)
            next(c)
            continue
        }
        if t == 36 {
            while g(c, 11) > 0 {
                let top = op(c, g(c, 11) - 1, 0)
                if top == 5 { break }
                if top == 6 { break }
                apply(s, c, o)
            }
            if g(c, 11) == 0 { break }
            let top = g(c, 11) - 1
            if op(c, top, 0) != 6 { bad(s, c) }
            argument(s, c, top)
            next(c)
            skip(c)
            wanted = true
            continue
        }
        if t == 1 {
            if g(c, 13) > 0 { skip(c)
                continue }
        }
        break
    }
    if wanted { bad(s, c) }
    while g(c, 11) > 0 {
        let t = op(c, g(c, 11) - 1, 0)
        if t == 5 { bad(s, c) }
        if t == 6 { bad(s, c) }
        apply(s, c, o)
    }
    if g(c, 12) != 1 { bad(s, c) }
    return pop_type(s, c)
}
fn next_back(c: bytes) { set(c, 0, g(c, 0) - 1) }
fn block(c: bytes, i: int64, p: int64) -> int64 { return get(c, 850000 + i * 40 + p) }
fn bset(c: bytes, i: int64, p: int64, v: int64) { put(c, 850000 + i * 40 + p, v) }
fn enter(s: bytes, c: bytes, kind: int64, a: int64, b: int64, returned: int64) {
    let i = g(c, 10)
    if i >= 128 { limit(s, c) }
    bset(c, i, 0, kind)
    bset(c, i, 4, g(c, 7))
    bset(c, i, 8, a)
    bset(c, i, 12, b)
    bset(c, i, 16, 0)
    bset(c, i, 20, returned)
    set(c, 10, i + 1)
}
fn epilogue(s: bytes, c: bytes, o: bytes, value: bool) {
    if value { emit(s, c, o, 88) }
    else { hex(s, c, o, "31c0") }
    hex(s, c, o, "c949ffccc3")
}
fn separator(s: bytes, c: bytes) {
    if tk(c) != 1 { if tk(c) != 8 { fail(s, c, "expected newline or closing brace") } }
    skip(c)
}
fn functions(s: bytes, c: bytes, o: bytes, d: bytes, f: bytes) {
    var fnid = 0
    while fnid < g(c, 2) {
        set(c, 0, field(c, fnid, 16))
        set(c, 7, 0)
        set(c, 9, 0)
        set(c, 10, 0)
        enter(s, c, 0, 0, 0, 0)
        var p = 0
        while p < arity(c, fnid) {
            declare(s, c, field(c, fnid, 64 + p * 12), field(c, fnid, 68 + p * 12), arg_type(c, fnid, p), 0)
            p = p + 1
        }
        fset(c, fnid, 24, g(c, 4))
        hex(s, c, o, "49ffc44983fc400f87")
        relative(s, c, o, depth_address())
        hex(s, c, o, "554889e54881ec")
        let frame_patch = g(c, 4)
        number(s, c, o, 0, 4)
        p = 0
        while p < arity(c, fnid) {
            hex(s, c, o, "488b85")
            number(s, c, o, 16 + (arity(c, fnid) - p - 1) * 8, 4)
            hex(s, c, o, "488985")
            number(s, c, o, -8 * (p + 1), 4)
            p = p + 1
        }
        while g(c, 10) > 0 {
            skip(c)
            let t = tk(c)
            if t == 0 { bad(s, c) }
            let top = g(c, 10) - 1
            if t == 8 {
                let kind = block(c, top, 0)
                let a = block(c, top, 8)
                let b = block(c, top, 12)
                let returned = block(c, top, 16)
                let then_return = block(c, top, 20)
                set(c, 7, block(c, top, 4))
                set(c, 10, top)
                next(c)
                if kind == 0 {
                    if result_type(c, fnid) != 2 { if returned == 0 { fail(s, c, "function may reach its end without returning") } }
                    epilogue(s, c, o, false)
                    put(o, frame_patch, ((g(c, 9) * 8 + 15) / 16) * 16)
                    break
                }
                if kind == 1 {
                    var separated = false
                    if tk(c) == 1 { separated = true }
                    skip(c)
                    if tk(c) == 24 {
                        jump(s, c, o, f, b)
                        mark(c, f, a)
                        next(c)
                        expect(s, c, 7)
                        enter(s, c, 2, a, b, returned)
                        continue
                    }
                    mark(c, f, a)
                    if !separated { if tk(c) != 8 { bad(s, c) } }
                    continue
                }
                if kind == 2 {
                    mark(c, f, b)
                    if then_return == 1 { if returned == 1 { bset(c, top - 1, 16, 1) } }
                    separator(s, c)
                    continue
                }
                if kind == 3 {
                    jump(s, c, o, f, a)
                    mark(c, f, b)
                    separator(s, c)
                    continue
                }
            }
            if t == 23 {
                next(c)
                if expression(s, c, o, d, f) != 1 { bad(s, c) }
                let no = label(s, c)
                let end = label(s, c)
                hex(s, c, o, "584885c00f84")
                fix(s, c, o, f, 2, no)
                expect(s, c, 7)
                enter(s, c, 1, no, end, 0)
                continue
            }
            if t == 25 {
                let start = label(s, c)
                let end = label(s, c)
                mark(c, f, start)
                next(c)
                if expression(s, c, o, d, f) != 1 { bad(s, c) }
                hex(s, c, o, "584885c00f84")
                fix(s, c, o, f, 2, end)
                expect(s, c, 7)
                enter(s, c, 3, start, end, 0)
                continue
            }
            if t == 26 {
                var level = top
                while level >= 0 {
                    if block(c, level, 0) == 3 { break }
                    level = level - 1
                }
                if level < 0 { bad(s, c) }
                jump(s, c, o, f, block(c, level, 12))
                next(c)
                separator(s, c)
                continue
            }
            if t == 27 {
                var level = top
                while level >= 0 {
                    if block(c, level, 0) == 3 { break }
                    level = level - 1
                }
                if level < 0 { bad(s, c) }
                jump(s, c, o, f, block(c, level, 8))
                next(c)
                separator(s, c)
                continue
            }
            if t == 38 {
                next(c)
                let rt = result_type(c, fnid)
                if rt == 2 {
                    if tk(c) != 1 { if tk(c) != 8 { bad(s, c) } }
                    epilogue(s, c, o, false)
                } else {
                    if expression(s, c, o, d, f) != rt { bad(s, c) }
                    epilogue(s, c, o, true)
                }
                bset(c, top, 16, 1)
                separator(s, c)
                continue
            }
            if t == 4 {
                next(c)
                expect(s, c, 5)
                let pt = expression(s, c, o, d, f)
                expect(s, c, 6)
                emit(s, c, o, 88)
                emit(s, c, o, 232)
                if pt == 0 { relative(s, c, o, integer_address()) }
                else {
                    if pt == 1 { relative(s, c, o, boolean_address()) }
                    else {
                        if pt != 3 { bad(s, c) }
                        relative(s, c, o, print_buffer_address())
                    }
                }
                separator(s, c)
                continue
            }
            if t == 19 {
                next(c)
                if tk(c) != 11 { bad(s, c) }
                let a = off(c)
                let n = length(c)
                next(c)
                expect(s, c, 18)
                let dt = expression(s, c, o, d, f)
                if dt == 2 { bad(s, c) }
                let slot = declare(s, c, a, n, dt, 0)
                store(s, c, o, slot)
                separator(s, c)
                continue
            }
            if t == 20 {
                next(c)
                if tk(c) != 11 { bad(s, c) }
                let a = off(c)
                let n = length(c)
                next(c)
                expect(s, c, 18)
                let dt = expression(s, c, o, d, f)
                if dt == 2 { bad(s, c) }
                let slot = declare(s, c, a, n, dt, 1)
                store(s, c, o, slot)
                separator(s, c)
                continue
            }
            if t == 11 {
                let saved = g(c, 0)
                let found = symbol(s, c, off(c), length(c))
                next(c)
                if tk(c) == 18 {
                    if found < 0 { set(c, 0, saved)
                        bad(s, c) }
                    if sym(c, found, 12) == 0 { bad(s, c) }
                    next(c)
                    if expression(s, c, o, d, f) != sym(c, found, 8) { bad(s, c) }
                    store(s, c, o, sym(c, found, 16))
                } else {
                    if tk(c) != 5 { set(c, 0, saved)
                        bad(s, c) }
                    var end = saved + 2
                    var nesting = 1
                    while nesting > 0 {
                        let token_kind = get(c, 200000 + end * 12)
                        if token_kind == 0 { bad(s, c) }
                        if token_kind == 5 { nesting = nesting + 1 }
                        if token_kind == 6 { nesting = nesting - 1 }
                        end = end + 1
                    }
                    set(c, 0, saved)
                    expression(s, c, o, d, f)
                    if g(c, 0) != end { bad(s, c) }
                    emit(s, c, o, 88)
                }
                separator(s, c)
                continue
            }
            bad(s, c)
        }
        fnid = fnid + 1
    }
}
fn elf(s: bytes, c: bytes, o: bytes, d: bytes, f: bytes) -> bytes {
    let rx = g(c, 4)
    let data = ((rx + 4095) / 4096) * 4096
    let size = data + g(c, 14)
    if size > buffer_len(o) { limit(s, c) }
    put(o, 0, 1179403647)
    buffer_set(o, 4, 2)
    buffer_set(o, 5, 1)
    buffer_set(o, 6, 1)
    buffer_set(o, 16, 2)
    buffer_set(o, 18, 62)
    put(o, 20, 1)
    put(o, 24, 4194304 + runtime_end())
    put(o, 32, 64)
    buffer_set(o, 52, 64)
    buffer_set(o, 54, 56)
    buffer_set(o, 56, 3)
    put(o, 64, 1)
    put(o, 68, 5)
    put(o, 80, 4194304)
    put(o, 88, 4194304)
    put(o, 96, rx)
    put(o, 104, rx)
    put(o, 112, 4096)
    put(o, 120, 1)
    put(o, 124, 4)
    put(o, 128, data)
    put(o, 136, 4194304 + data)
    put(o, 144, 4194304 + data)
    put(o, 152, g(c, 14))
    put(o, 160, g(c, 14))
    put(o, 168, 4096)
    put(o, 176, 1685382481)
    put(o, 180, 6)
    put(o, 224, 16)
    var i = 0
    while i < g(c, 5) {
        let at = get(f, i * 12)
        let kind = get(f, i * 12 + 4)
        let value = get(f, i * 12 + 8)
        var target = 0
        if kind == 1 { target = field(c, value, 24) }
        if kind == 2 { target = get(f, 600000 + value * 4) }
        if kind == 3 { target = data + value }
        put(o, at, target - at - 4)
        i = i + 1
    }
    i = 0
    while i < g(c, 14) {
        buffer_set(o, data + i, buffer_get(d, i))
        i = i + 1
    }
    let result = buffer(size)
    i = 0
    while i < size {
        buffer_set(result, i, buffer_get(o, i))
        i = i + 1
    }
    return result
}
fn main() {
    let argc = arg_count()
    if argc == 2 {
        let option = arg(1)
        if equal(option, "--version") { print("Ramos 0.6.0 — compiler written in Ramos")
            return }
        if equal(option, "--help") { print("Usage: ramos build SOURCE.ramos -o EXECUTABLE [--force]")
            return }
    }
    if argc != 5 { if argc != 6 { stderr("error: usage: ramos build SOURCE.ramos -o EXECUTABLE [--force]\n")
            exit(1) } }
    if !equal(arg(1), "build") { stderr("error: expected build\n")
        exit(1) }
    if !equal(arg(3), "-o") { stderr("error: expected -o\n")
        exit(1) }
    var flags = 1
    if argc == 6 {
        if !equal(arg(5), "--force") { stderr("error: expected --force\n")
            exit(1) }
        flags = 3
    }
    let s = read_file(arg(2))
    let c = buffer(1048576)
    if io_error() != 0 { fail(s, c, "cannot read input (readable regular file required; source size limit is 1048576)") }
    utf8(s, c)
    lex(s, c)
    discover(s, c)
    let o = buffer(1048576)
    let d = buffer(1048576)
    let f = buffer(1048576)
    set(c, 4, 4096)
    hex(s, c, o, runtime_text())
    hex(s, c, o, entry_text())
    emit(s, c, o, 232)
    fix(s, c, o, f, 1, g(c, 3))
    hex(s, c, o, "b83c00000031ff0f05")
    functions(s, c, o, d, f)
    let result = elf(s, c, o, d, f)
    if write_file(arg(4), result, flags) != 0 { fail(s, c, "cannot publish output: check existing file, source alias, directory and permissions") }
}

fn runtime_text() -> bytes { return "" }
fn entry_text() -> bytes { return "fc4531e44531ed4531f64889e04883ec304989e749890749c747080000000049c7472000000000" }
fn runtime_end() -> int64 { return 6322 }
fn math_address() -> int64 { return 4277 }
fn depth_address() -> int64 { return 4313 }
fn literal_address() -> int64 { return 4564 }
fn integer_address() -> int64 { return 4147 }
fn boolean_address() -> int64 { return 4227 }
fn print_buffer_address() -> int64 { return 4617 }
fn builtin_address(n: int64) -> int64 {
    if n == 0 { return 4457 }
    if n == 1 { return 4581 }
    if n == 2 { return 4585 }
    if n == 3 { return 4596 }
    if n == 4 { return 4964 }
    if n == 5 { return 4971 }
    if n == 6 { return 5147 }
    if n == 7 { return 5653 }
    if n == 8 { return 5017 }
    if n == 9 { return 5022 }
    if n == 10 { return 5042 }
    return 0
}
