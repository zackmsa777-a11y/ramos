    if f >= 512 { return record(c, f - 512, 40 + i * 20) }
    if f < 256 { return field(c, f, 64 + i * 12 + 8) }
    if f == 256 { return 0 }
    if f == 261 { return 0 }
    if f == 266 { return 0 }
    if f == 270 { return 0 }
    if f == 276 { return 4 }
    if f == 277 { return 4 }
    if f == 278 { if i == 0 { return 4 }
        return 0 }
    if f == 263 { if i == 2 { return 0 }
        return 3 }
    if i == 0 { return 3 }
    return 0
}
fn type(s: bytes, c: bytes) -> int64 {
    skip(c)
    var depth = 0
    while tk(c) == 48 {
        depth = depth + 1
        if depth > 16 { limit(s, c) }
        next(c)
        skip(c)
    }
    let token_kind = tk(c)
    var t = -1
    if token_kind == 39 { t = 0 }
    if token_kind == 40 { t = 1 }
    if token_kind == 41 { t = 2 }
    if token_kind == 42 { t = 3 }
    if token_kind == 45 { t = 4 }
    if token_kind == 11 {
        let r = record_find(s, c, off(c), length(c))
        if r >= 0 { t = 1000 + r }
    }
    if t < 0 { fail(s, c, "expected type: int64, bool, bytes, string, struct, array or void") }
