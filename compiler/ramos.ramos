}
fn limit(s: bytes, c: bytes) { fail(s, c, "compiler limit exceeded") }
fn bad(s: bytes, c: bytes) { fail(s, c, "unexpected token") }
fn type_name(t: int64) -> bytes {
    if t == 0 { return "int64" }
    if t == 1 { return "bool" }
    if t == 3 { return "bytes" }
    if t == 4 { return "string" }
    if t >= 100000 { return "array" }
    if t >= 1000 { return "struct" }
    return "void"
}
fn concat(a: bytes, b: bytes) -> bytes {
    let n = buffer_len(a)
    let out = buffer(n + buffer_len(b))
    var i = 0
    while i < n { buffer_set(out, i, buffer_get(a, i))
        i = i + 1 }
    i = 0
    while i < buffer_len(b) { buffer_set(out, n + i, buffer_get(b, i))
        i = i + 1 }
    return out
}
fn type_error(s: bytes, c: bytes, expected: int64, actual: int64) {
    fail(s, c, concat(concat(concat("expected ", type_name(expected)), ", found "), type_name(actual)))
}
fn expected(s: bytes, c: bytes, t: int64) {
    if t == 2 { fail(s, c, "expected 'fn' or 'struct' at top level; use 'weave' for libraries") }
    if t == 5 { fail(s, c, "expected '('") }
    if t == 6 { fail(s, c, "expected ')'") }
    if t == 7 { fail(s, c, "expected '{'") }
    if t == 8 { fail(s, c, "expected '}'") }
    if t == 18 { fail(s, c, "expected '=' before initializer") }
    if t == 35 { fail(s, c, "expected ':' before parameter type") }
