fn field(c: bytes, n: int64, p: int64) -> int64 { return get(c, 256 + n * 256 + p) }
fn fset(c: bytes, n: int64, p: int64, v: int64) { put(c, 256 + n * 256 + p, v) }
fn record(c: bytes, n: int64, p: int64) -> int64 { return get(c, 857000 + n * 512 + p) }
fn rset(c: bytes, n: int64, p: int64, value: int64) { put(c, 857000 + n * 512 + p, value) }
fn record_find(s: bytes, c: bytes, a: int64, n: int64) -> int64 {
    var i = 0
    while i < g(c, 20) {
        if same(s, a, n, record(c, i, 0), record(c, i, 4)) { return i }
        i = i + 1
    }
    return -1
}
fn record_field(s: bytes, c: bytes, t: int64) -> int64 {
