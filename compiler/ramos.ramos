        if assignment_kind(tk(c)) {
            let kind = tk(c)
            let at = off(c)
            if kind != 18 {
                if indexed { hex(s, c, o, "488b442408488b0c24") }
                else { hex(s, c, o, "488b042448b9")
                    number(s, c, o, index, 8) }
                emit(s, c, o, 232)
                relative(s, c, o, native_builtin(c, 31))
                value_push(s, c, o)
            }
            next(c)
            let value_type = expression(s, c, o, d, f)
            if kind == 18 {
                if value_type != element_type { type_error(s, c, element_type, value_type) }
            } else { compound(s, c, o, f, kind, element_type, value_type, at) }
            consume(s, c, o, 2)
            if indexed { consume(s, c, o, 1) }
            consume(s, c, o, 0)
            if !indexed { hex(s, c, o, "48b9")
                number(s, c, o, index, 8) }
            emit(s, c, o, 232)
            relative(s, c, o, native_builtin(c, 32))
            return
        }
        if indexed { consume(s, c, o, 1) }
        consume(s, c, o, 0)
        if !indexed { hex(s, c, o, "48b9")
            number(s, c, o, index, 8) }
        emit(s, c, o, 232)
        relative(s, c, o, native_builtin(c, 31))
        value_push(s, c, o)
        current_type = element_type
