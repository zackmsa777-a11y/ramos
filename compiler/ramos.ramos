                separator(s, c)
                continue
            }
            if t == 27 {
                var level = top
                while level >= 0 {
                    if block(c, level, 0) == 3 { break }
                    if block(c, level, 0) == 4 { break }
                    level = level - 1
                }
                if level < 0 { fail(s, c, "break and continue require an enclosing loop") }
                var first = block(c, level, 4)
                if block(c, level, 0) == 4 { first = first + 1 }
                clear_scope(s, c, o, first)
                jump(s, c, o, f, block(c, level, 8))
                next(c)
                separator(s, c)
                continue
            }
            if t == 38 {
                next(c)
                let rt = result_type(c, fnid)
                if rt == 2 {
                    if tk(c) != 1 { if tk(c) != 8 { bad(s, c) } }
                    epilogue(s, c, o, false)
                } else {
                    let returned_type = expression(s, c, o, d, f)
                    if returned_type != rt { type_error(s, c, rt, returned_type) }
