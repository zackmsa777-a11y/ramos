                    mark(c, f, a)
                    load(s, c, o, block(c, top, 24))
                    consume(s, c, o, 0)
                    hex(s, c, o, "4883c0010f80")
                    relative(s, c, o, native_address(c, 0))
                    value_push(s, c, o)
                    store(s, c, o, block(c, top, 24))
                    jump(s, c, o, f, block(c, top, 32))
