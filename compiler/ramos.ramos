                            consume(s, c, o, 0)
                            hex(s, c, o, "4885c00f84")
                            fix(s, c, o, f, 2, no)
                            expect(s, c, 7)
                            enter(s, c, 1, no, b, all_return)
                        } else {
                            expect(s, c, 7)
                            enter(s, c, 2, a, b, all_return)
