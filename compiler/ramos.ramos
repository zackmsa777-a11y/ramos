            next(c)
            skip(c)
            let index_type = expression(s, c, o, d, f)
            if index_type != 0 { type_error(s, c, 0, index_type) }
            expect(s, c, 49)
            consume(s, c, o, 1)
            consume(s, c, o, 0)
