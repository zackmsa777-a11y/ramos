            consume(s, c, o, 0)
            emit(s, c, o, 232)
            relative(s, c, o, native_builtin(c, 25))
            value_push(s, c, o)
            typed(s, c, op(c, top, 4) - 100000)
            set(c, 11, top)
            set(c, 13, g(c, 13) - 1)
