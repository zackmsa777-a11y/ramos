            if t == 14 {
                push_op(s, c, 114, 0)
                next(c)
                skip(c)
                continue
            }
            if t == 28 {
                push_op(s, c, 128, 0)
                next(c)
                skip(c)
                continue
            }
            if t == 5 {
                push_op(s, c, 5, 0)
                next(c)
                skip(c)
                continue
            }
            if t == 12 { literal(s, c, o) }
            else {
