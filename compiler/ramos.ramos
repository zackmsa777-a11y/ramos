            if g(c, 11) == 0 { break }
            let top = g(c, 11) - 1
            if op(c, top, 0) == 6 {
                argument(s, c, top)
                let id = op(c, top, 4)
                if op(c, top, 8) != arity(c, id) { fail(s, c, "too few function arguments") }
                let array_type = op(c, top, 20)
                set(c, 11, top)
                call_emit(s, c, o, f, id)
                if type_argument(id) { pop_type(s, c)
                    typed(s, c, array_type) }
                if id == 281 { pop_type(s, c)
                    typed(s, c, array_type - 100000) }
                if id == 283 { pop_type(s, c)
                    typed(s, c, array_type) }
