    big_mul(n, 2, 0)
    let halfway = big_compare(n, d)
    var round_up = halfway > 0
    if halfway == 0 { if quotient % 2 == 1 { round_up = true } }
    if round_up { quotient = quotient + 1 }
    if power < -1022 { return quotient }
    if quotient == 9007199254740992 { quotient = quotient / 2
