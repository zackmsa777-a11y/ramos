    buffer_set(o, 52, 64)
    buffer_set(o, 54, 56)
    buffer_set(o, 56, 3)
    put(o, 64, 1)
    put(o, 68, 5)
    put(o, 80, 4194304)
    put(o, 88, 4194304)
