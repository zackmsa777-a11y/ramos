}
fn tk(c: bytes) -> int64 { return get(c, 200000 + g(c, 0) * 12) }
fn off(c: bytes) -> int64 { return get(c, 200000 + g(c, 0) * 12 + 4) }
fn length(c: bytes) -> int64 { return get(c, 200000 + g(c, 0) * 12 + 8) }
