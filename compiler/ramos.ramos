        i = i + 1
    }
    return true
}
fn decimal(v: int64) -> bytes { return int_to_text(v) }
fn fail(s: bytes, c: bytes, message: bytes) {
    var pos = 0
    let t = g(c, 0)
    if t < g(c, 1) { pos = get(c, 200000 + t * 12 + 4) }
    if g(c, 15) > 0 { pos = g(c, 15) - 1 }
    var origin = 0
    var filename = arg(2)
    var source_id = 0
    while source_id < g(c, 21) {
        if module(c, source_id, 16) == 1 {
            if pos >= module(c, source_id, 0) { if pos <= module(c, source_id, 4) {
                origin = module(c, source_id, 0)
                filename = module_path(c, source_id)
            } }
        }
        source_id = source_id + 1
    }
    var line = 1
    var column = 1
    var i = origin
    while i < pos {
        if buffer_get(s, i) == 10 {
            line = line + 1
            column = 1
        } else { column = column + 1 }
        i = i + 1
    }
    stderr(filename)
    stderr(":")
    stderr(decimal(line))
    stderr(":")
    stderr(decimal(column))
    stderr(": error: ")
    stderr(message)
    stderr("\n")
