                let found = symbol(s, c, off(c), length(c))
                next(c)
                if tk(c) == 47 {
                    aggregate_assignment(s, c, o, d, f, found)
                } else { if tk(c) == 48 {
                    aggregate_assignment(s, c, o, d, f, found)
                } else { if tk(c) == 18 {
                    if found < 0 { set(c, 0, saved)
                        fail(s, c, "unknown variable") }
                    if sym(c, found, 12) == 0 { fail(s, c, "cannot assign to an immutable let binding") }
                    next(c)
                    let assigned_type = expression(s, c, o, d, f)
                    if assigned_type != sym(c, found, 8) { type_error(s, c, sym(c, found, 8), assigned_type) }
                    store(s, c, o, sym(c, found, 16))
