            }
            if t == 20 {
                next(c)
                if tk(c) != 11 { bad(s, c) }
                let a = off(c)
                let n = length(c)
                next(c)
                expect(s, c, 18)
                let dt = expression(s, c, o, d, f)
                if dt == 2 { fail(s, c, "a void call cannot initialize a binding") }
                let slot = declare(s, c, a, n, dt, 1)
                store(s, c, o, slot)
                separator(s, c)
                continue
