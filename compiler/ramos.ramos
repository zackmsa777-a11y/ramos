}
fn find(s: bytes, c: bytes, a: int64, n: int64) -> int64 {
    var i = 0
    while i < g(c, 2) {
        if same(s, a, n, field(c, i, 0), field(c, i, 4)) { return i }
        i = i + 1
    }
    let r = record_find(s, c, a, n)
    if r >= 0 { return 512 + r }
    return builtin(s, a, n)
}
fn arity(c: bytes, f: int64) -> int64 {
    if f >= 512 { return record(c, f - 512, 8) }
    if f < 256 { return field(c, f, 8) }
    if f == 260 { return 0 }
    if f == 264 { return 0 }
    if f == 267 { return 0 }
    if f == 268 { return 0 }
    if f == 269 { return 0 }
    if f == 272 { return 0 }
    if f == 273 { return 0 }
    if f == 274 { return 0 }
    if f == 290 { return 0 }
    if f == 258 { return 2 }
    if f == 259 { return 3 }
    if f == 263 { return 3 }
    if f == 278 { return 3 }
    if f == 279 { return 3 }
    if f == 281 { return 2 }
    if f == 282 { return 3 }
    if f == 283 { return 3 }
    return 1
}
