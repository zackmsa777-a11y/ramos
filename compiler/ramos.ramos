            if v < 194 { fail(s, c, "invalid UTF-8 encoding") }
            if v >= 224 { n = 3 }
            if v >= 240 { n = 4 }
            if v > 244 { fail(s, c, "invalid UTF-8 encoding") }
            if i + n > buffer_len(s) { fail(s, c, "invalid UTF-8 encoding") }
            let w = buffer_get(s, i + 1)
            if v == 224 { if w < 160 { fail(s, c, "invalid UTF-8 encoding") } }
            if v == 237 { if w > 159 { fail(s, c, "invalid UTF-8 encoding") } }
            if v == 240 { if w < 144 { fail(s, c, "invalid UTF-8 encoding") } }
            if v == 244 { if w > 143 { fail(s, c, "invalid UTF-8 encoding") } }
