weave "bytes.ramos"

// Scalar-based string helpers; search returns -1 when no match exists.
fn text_starts(text: string, prefix: string) -> bool {
    let size = len(prefix)
    if size > len(text) { return false }
    return slice(text, 0, size) == prefix
}
fn text_ends(text: string, suffix: string) -> bool {
    let size = len(suffix)
    let total = len(text)
    if size > total { return false }
    return slice(text, total - size, total) == suffix
}
fn text_find(text: string, needle: string) -> int64 {
    let total = len(text)
    let size = len(needle)
    var i = 0
    while i + size <= total {
        if slice(text, i, i + size) == needle { return i }
        i = i + 1
    }
    return -1
}
fn text_contains(text: string, needle: string) -> bool {
    return text_find(text, needle) >= 0
}
fn text_join(parts: [string], separator: string) -> string {
    let separator_bytes = to_bytes(separator)
    var total = 0
    var i = 0
    while i < array_len(parts) {
        let part = to_bytes(parts[i])
        total = total + buffer_len(part)
        if i > 0 { total = total + buffer_len(separator_bytes) }
        i = i + 1
    }
    let out = buffer(total)
    var at = 0
    i = 0
    while i < array_len(parts) {
        if i > 0 { bytes_put(out, at, separator_bytes)
            at = at + buffer_len(separator_bytes) }
        let part = to_bytes(parts[i])
        bytes_put(out, at, part)
        at = at + buffer_len(part)
        i = i + 1
    }
    return string(out)
}
fn text_repeat(text: string, count: int64) -> string {
    if count < 0 { stderr("Ramos library error: negative repeat count\n")
        exit(1) }
    let raw = to_bytes(text)
    if buffer_len(raw) == 0 { return s"" }
    let out = buffer(buffer_len(raw) * count)
    var i = 0
    while i < count {
        bytes_put(out, i * buffer_len(raw), raw)
        i = i + 1
    }
    return string(out)
}
