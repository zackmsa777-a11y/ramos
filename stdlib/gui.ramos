// Native desktop GUI (Windows x64). IDs are 1..64, coordinates are pixels.
// No callbacks or OS handles escape into Ramos. Poll ordinary typed events.
struct GuiEvent { kind: int64, id: int64, width: int64, height: int64 }

fn gui_word(out: bytes, at: int64, value: int64) {
    if value < 0 { stderr("Ramos GUI error: negative property\n")
        exit(1) }
    var n = value
    var i = 0
    while i < 8 { buffer_set(out, at + i, n % 256)
        n = n / 256
        i = i + 1 }
}
fn gui_number(raw: bytes, at: int64) -> int64 {
    var n = 0
    var i = 7
    while i >= 0 { n = n * 256 + buffer_get(raw, at + i)
        i = i - 1 }
    return n
}
fn gui_check(status: int64) {
    if status != 0 {
        _gui_close()
        stderr("Ramos GUI error: native operation failed, status ")
        stderr(int_to_text(status))
        stderr("\n")
        exit(1)
    }
}
// Opening is fallible: -38 means this platform has no GUI backend yet.
fn gui_open(title: string, width: int64, height: int64) -> int64 {
    return _gui_open(to_bytes(title), width, height)
}
fn gui_close() -> int64 { return _gui_close() }
fn gui_rgb(red: int64, green: int64, blue: int64) -> int64 {
    if red < 0 || red > 255 || green < 0 || green > 255 || blue < 0 || blue > 255 {
        stderr("Ramos GUI error: color components must be 0..255\n")
        exit(1)
    }
    return red + green * 256 + blue * 65536
}
fn gui_properties(kind: int64, id: int64, x: int64, y: int64,
                  width: int64, height: int64, color: int64) -> bytes {
    let out = buffer(56)
    gui_word(out, 0, kind)
    gui_word(out, 8, id)
    gui_word(out, 16, x)
    gui_word(out, 24, y)
    gui_word(out, 32, width)
    gui_word(out, 40, height)
    gui_word(out, 48, color)
    return out
}
fn gui_label(id: int64, x: int64, y: int64, width: int64, height: int64, text: string) {
    gui_check(_gui_control(gui_properties(1, id, x, y, width, height, 0), to_bytes(text)))
}
fn gui_button(id: int64, x: int64, y: int64, width: int64, height: int64, text: string) {
    gui_check(_gui_control(gui_properties(2, id, x, y, width, height, 0), to_bytes(text)))
}
fn gui_input(id: int64, x: int64, y: int64, width: int64, height: int64, text: string) {
    gui_check(_gui_control(gui_properties(3, id, x, y, width, height, 0), to_bytes(text)))
}
fn gui_editor(id: int64, x: int64, y: int64, width: int64, height: int64, text: string) {
    gui_check(_gui_control(gui_properties(4, id, x, y, width, height, 0), to_bytes(text)))
}
fn gui_panel(id: int64, x: int64, y: int64, width: int64, height: int64, color: int64) {
    gui_check(_gui_control(gui_properties(5, id, x, y, width, height, color), ""))
}
fn gui_set(id: int64, text: string) {
    gui_check(_gui_control(gui_properties(6, id, 0, 0, 0, 0, 0), to_bytes(text)))
}
fn gui_move(id: int64, x: int64, y: int64, width: int64, height: int64) {
    gui_check(_gui_control(gui_properties(7, id, x, y, width, height, 0), ""))
}
fn gui_text(id: int64) -> string {
    let raw = _gui_text(id)
    let status = io_error()
    gui_check(status)
    return string(raw)
}
// kind: 0 timeout, 1 close, 2 button, 3 resize, 4 parent key, 5 text changed.
// Resize carries client width/height. Key carries Windows virtual-key in id.
fn gui_event(timeout_ms: int64) -> GuiEvent {
    let raw = _gui_poll(timeout_ms)
    let status = io_error()
    gui_check(status)
    return GuiEvent(gui_number(raw, 0), gui_number(raw, 8),
                    gui_number(raw, 16), gui_number(raw, 24))
}
