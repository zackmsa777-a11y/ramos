weave "text.ramos"

// Helpers scan options before --. Applications still validate their own schema.
fn cli_arg(index: int64) -> string { return string(arg(index)) }
fn cli_has(name: string) -> bool {
    var i = 1
    while i < arg_count() {
        let item = cli_arg(i)
        if item == s"--" { return false }
        if item == name { return true }
        i = i + 1
    }
    return false
}
fn cli_value(name: string, fallback: string) -> string {
    var i = 1
    let prefix = name + s"="
    while i < arg_count() {
        let item = cli_arg(i)
        if item == s"--" { return fallback }
        if text_starts(item, prefix) { return slice(item, len(prefix), len(item)) }
        if item == name {
            if i + 1 >= arg_count() {
                stderr("Ramos CLI error: missing option value\n")
                exit(2)
            }
            return cli_arg(i + 1)
        }
        i = i + 1
    }
    return fallback
}
fn cli_fail(message: string) {
    stderr(to_bytes(message + s"\n"))
    exit(2)
}
