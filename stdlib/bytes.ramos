// Mutable binary copies; indices remain byte offsets.
fn bytes_copy(source: bytes) -> bytes {
    let out = buffer(buffer_len(source))
    var i = 0
    while i < buffer_len(source) { buffer_set(out, i, buffer_get(source, i))
        i = i + 1 }
    return out
}
fn bytes_equal(a: bytes, b: bytes) -> bool {
    if buffer_len(a) != buffer_len(b) { return false }
    var i = 0
    while i < buffer_len(a) {
        if buffer_get(a, i) != buffer_get(b, i) { return false }
        i = i + 1
    }
    return true
}
fn bytes_slice(source: bytes, start: int64, end: int64) -> bytes {
    if start < 0 || end < start || end > buffer_len(source) {
        stderr("Ramos library error: byte slice out of bounds\n")
        exit(1)
    }
    let out = buffer(end - start)
    var i = 0
    while i < buffer_len(out) { buffer_set(out, i, buffer_get(source, start + i))
        i = i + 1 }
    return out
}
fn bytes_put(out: bytes, start: int64, source: bytes) {
    if start < 0 || start + buffer_len(source) > buffer_len(out) {
        stderr("Ramos library error: byte copy out of bounds\n")
        exit(1)
    }
    var i = 0
    while i < buffer_len(source) { buffer_set(out, start + i, buffer_get(source, i))
        i = i + 1 }
}
// Literal binary search. Empty needle matches at zero; -1 means missing.
fn bytes_find(haystack: bytes, needle: bytes) -> int64 {
    if buffer_len(needle) == 0 { return 0 }
    var i = 0
    while i <= buffer_len(haystack) - buffer_len(needle) {
        var j = 0
        var matches = true
        while j < buffer_len(needle) && matches {
            if buffer_get(haystack, i + j) != buffer_get(needle, j) { matches = false }
            j = j + 1
        }
        if matches { return i }
        i = i + 1
    }
    return -1
}
