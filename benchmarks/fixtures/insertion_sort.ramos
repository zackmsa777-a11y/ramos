fn number(text: bytes) -> int64 {
    var value = 0
    var i = 0
    while i < buffer_len(text) {
        value = value * 10 + buffer_get(text, i) - 48
        i = i + 1
    }
    return value
}
fn kernel(n: int64, seed: int64) -> int64 {
    let b = buffer(128)
    var total = 0
    var repeat = 0
    while repeat < n {
        var i = 0
        while i < 128 {
            buffer_set(b, i, (i * 73 + seed + repeat) % 256)
            i = i + 1
        }
        i = 1
        while i < 128 {
            let v = buffer_get(b, i)
            var j = i
            while j > 0 {
                let prev = buffer_get(b, j - 1)
                if prev <= v { break }
                buffer_set(b, j, prev)
                j = j - 1
            }
            buffer_set(b, j, v)
            i = i + 1
        }
        i = 0
        while i < 128 {
            total = (total + buffer_get(b, i) * (i + 1)) % 1000000007
            i = i + 1
        }
        repeat = repeat + 1
    }
    return total
}
fn main() { print(kernel(number(arg(1)), number(arg(2)))) }
